// resolver.lume — GraphQL resolver 生成器（模板渲染版）
// 对照 nsgm src/generators/resolver-generator.ts；M1 精简：不含 DataLoader 与批量方法
import "model.lume" as m;
import "tpl.lume" as tpl;

export func gen_resolver(ctrl: string, fs, n: int): string {
  let C = m.cap(ctrl);
  let sel = all_names(fs, n);
  let form = m.form_idx(fs, n);
  let search = m.search_idx(fs, n);
  let ins_fields = names_csv(fs, form);
  let ins_q = qmarks(len(form));
  let ins_vals = insert_values(fs, form);
  let upd = update_fields(fs, form);
  let conds = search_conds(fs, search);
  let ctx = {
    "ctrl": ctrl, "C": C, "sel": sel,
    "ins_fields": ins_fields, "ins_q": ins_q, "ins_vals": ins_vals,
    "upd": upd, "conds": conds
  };
  let tpl_text = read_file("templates/resolver.tpl");
  if (tpl_text == null) { return "// ERROR: templates/resolver.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

func all_names(fs, n: int): string {
  let out = [];
  let i = 0;
  while (i < n) {
    push(out, m.fname(fs[i]));
    i = i + 1;
  }
  return join(out, ", ");
}

func names_csv(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    push(out, m.fname(fs[idx[i]]));
    i = i + 1;
  }
  return join(out, ", ");
}

func qmarks(k: int): string {
  let out = [];
  let i = 0;
  while (i < k) {
    push(out, "?");
    i = i + 1;
  }
  return join(out, ", ");
}

// INSERT VALUES：data.<name>（integer 字段走 parseInt 前的原始值——M1 简化）
func insert_values(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    push(out, "data." + m.fname(fs[idx[i]]));
    i = i + 1;
  }
  return join(out, ", ");
}

// UPDATE SET：name = ?
func update_fields(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    push(out, m.fname(fs[idx[i]]) + " = ?");
    i = i + 1;
  }
  return join(out, ", ");
}

// 搜索条件：data.name ? 追加到 whereSql
func search_conds(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let nm = m.fname(fs[idx[i]]);
    push(out, "            if (data." + nm + " !== undefined && data." + nm + " !== '') {");
    push(out, "                whereSql += ' AND `" + nm + "` = ?';");
    push(out, "                values.push(data." + nm + ");");
    push(out, "            }");
    i = i + 1;
  }
  return join(out, "\n");
}
