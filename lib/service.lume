// service.lume — GraphQL 客户端服务生成器（模板渲染版）
// 对照 nsgm src/generators/service-generator.ts；M1 精简：不含 integer 校验函数与批量方法
import "model.lume" as m;
import "tpl.lume" as tpl;

export func gen_service(ctrl: string, fs, n: int): string {
  let C = m.cap(ctrl);
  let sel = select_fields(fs, n);
  let form = m.form_idx(fs, n);
  let search = m.search_idx(fs, n);
  let f_names = names(fs, form);
  let s_names = names(fs, search);
  let ctx = { "ctrl": ctrl, "C": C, "sel": sel, "f_names": f_names, "s_names": s_names };
  let tpl_text = read_file("templates/service.tpl");
  if (tpl_text == null) { return "// ERROR: templates/service.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 查询字段：排除 create_date / update_date（对齐 nsgm）
func select_fields(fs, n: int): string {
  let out = [];
  let i = 0;
  while (i < n) {
    let nm = m.fname(fs[i]);
    if (nm != "create_date" && nm != "update_date") { push(out, nm); }
    i = i + 1;
  }
  return join(out, " ");
}

// 指定下标集合的字段名（逗号分隔）
func names(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    push(out, m.fname(fs[idx[i]]));
    i = i + 1;
  }
  return join(out, ", ");
}
