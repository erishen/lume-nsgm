// base.lume — 输出以 lume 为底的可运行工程（app.lume + lib + modules + www + web）
// 与 lib/scaffold.lume 的 write_tree 配合：write_tree 写 modules/<ctrl>.lume
// 与 sql/<ctrl>.sql，本文件负责复制静态基座、生成 lib/ui.lume（NAV 注入）、
// app.lume 入口与 web/ React 前端（Vite + React + TS，经 lib/reactgen.lume）。
import "model.lume" as m;
import "reactgen.lume" as rg;

// 需要从 scaffold/ 复制的静态文件（路径相对于生成根 out）
let STATIC_FILES = [
  "lib/db.lume",
  "lib/pay.lume",
  "www/app.css",
  "www/app.js",
  "README.run.md"
];

// 复制静态基座文件（scaffold/ -> out/）
export func copy_base(out: string): int {
  let i = 0;
  while (i < len(STATIC_FILES)) {
    let f = STATIC_FILES[i];
    let content = read_file("scaffold/" + f);
    if (content != null) {
      write_file(out + "/" + f, content);
    } else {
      print("WARN: scaffold/" + f + " missing");
    }
    i = i + 1;
  }
  return 0;
}

// 生成 lib/ui.lume：SSR 组件库，NAV 由模块清单注入（shop 非 null 时加商城入口）
export func gen_ui(out: string, mods, shop): int {
  let nav_rows = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      let label = get(mod, "label", name);
      nav_rows = nav_rows + "  [\"" + name + "\", \"" + label + "\"],\n";
    }
    i = i + 1;
  }
  if (shop != null) {
    nav_rows = nav_rows + "  [\"shop\", \"商城\"],\n";
  }
  let content = "// lib/ui.lume — SSR 组件库（lume-nsgm 生成：NAV 为模块清单）\n"
    + "let NAV = [\n" + nav_rows + "];\n\n"
    + "export func esc(s): string {\n"
    + "  let out = str(s);\n"
    + "  out = replace(out, \"&\", \"&amp;\");\n"
    + "  out = replace(out, \"<\", \"&lt;\");\n"
    + "  out = replace(out, \">\", \"&gt;\");\n"
    + "  out = replace(out, \"\\\"\", \"&quot;\");\n"
    + "  return out;\n"
    + "}\n\n"
    + "export func nav(active: string): string {\n"
    + "  let out = \"<header class=\\\"nav\\\"><a class=\\\"brand\\\" href=\\\"/\\\">lume-nsgm</a>\";\n"
    + "  let i = 0;\n"
    + "  while (i < len(NAV)) {\n"
    + "    let item = NAV[i];\n"
    + "    let cls = \"\";\n"
    + "    if (item[0] == active) { cls = \" class=\\\"active\\\"\"; }\n"
    + "    out = out + \"<a\" + cls + \" href=/\" + item[0] + \">\" + esc(item[1]) + \"</a>\";\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return out + \"</header>\";\n"
    + "}\n\n"
    + "export func page(title: string, active: string, body: string): string {\n"
    + "  return \"<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n\"\n"
    + "    + \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"\n"
    + "    + \"<title>\" + esc(title) + \"</title>\\n\"\n"
    + "    + \"<link rel=\\\"stylesheet\\\" href=\\\"/app.css\\\">\\n\"\n"
    + "    + \"<script src=\\\"/app.js\\\" defer></script>\\n</head>\\n<body>\\n\"\n"
    + "    + nav(active)\n"
    + "    + \"<main class=\\\"container\\\">\\n\" + body + \"</main>\\n</body>\\n</html>\\n\";\n"
    + "}\n";
  write_file(out + "/lib/ui.lume", content);
  return 0;
}

// 生成支付接线块（config.pay 存在时注入 app.lume）：
//   PAY_CFG（密钥走 env）+ post /api/pay/create + post <notify_path> 两条路由。
// 表名/列名/notify_path 均已过 validate.lume 白名单（标识符/路径形状校验），
// 可安全拼进生成的 SQL 与路由字符串；商户标识限令牌字符集（见 validate_pay）。
func gen_pay_block(pay): string {
  let provider = str(get(pay, "provider", "wechat"));
  if (provider == "paypal") { return gen_paypal_block(pay); }
  let gw = str(get(pay, "gateway", ""));
  let appid = str(get(pay, "appid", ""));
  let mchid = str(get(pay, "mchid", ""));
  let serial = str(get(pay, "serial_no", ""));
  let secret_env = str(get(pay, "secret_env", "PAY_SECRET"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let np = str(get(pay, "notify_path", "/api/pay/notify"));
  if (np == "") { np = "/api/pay/notify"; }
  let dflt_notify = "http://127.0.0.1:8081" + np;
  // SQL 片段（双引号标识符在生成文件里是 \"，故此处用 \\\"）
  let sel_amt = "SELECT \\\"" + amf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let sel_st = "SELECT \\\"" + stf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let upd_st = "UPDATE \\\"" + om + "\\\" SET \\\"" + stf + "\\\" = 'paid' WHERE \\\"" + onf + "\\\" = ?";
  let b = "// ---- 支付接线（lume-nsgm 生成；密钥从环境变量 " + secret_env + " 注入，勿硬编码）----\n"
    + "// 与真实微信支付 v3 的差距：签名为 HMAC-SHA256（真实为 SHA256-RSA，需签名\n"
    + "// sidecar 或 core 补 RSA 内建）；回调验签头 core 未暴露（req 无 headers），\n"
    + "// 故签名材料随 body 传递（沙箱约定）。详见 README「支付」节。\n"
    + "let PAY_SECRET_RAW = env(\"" + secret_env + "\");\n"
    + "let PAY_NOTIFY_RAW = env(\"PAY_NOTIFY_URL\");\n"
    + "let PAY_GATEWAY_RAW = env(\"PAY_GATEWAY\");\n"
    + "let PAY_CFG = {\n"
    + "  \"gw\": (PAY_GATEWAY_RAW != null && PAY_GATEWAY_RAW != \"\" ? str(PAY_GATEWAY_RAW) : \"" + gw + "\"),\n"
    + "  \"appid\": \"" + appid + "\",\n"
    + "  \"mchid\": \"" + mchid + "\",\n"
    + "  \"serial\": \"" + serial + "\",\n"
    + "  \"secret\": (PAY_SECRET_RAW != null ? str(PAY_SECRET_RAW) : \"\")\n"
    + "};\n"
    + "let PAY_NOTIFY_URL = (PAY_NOTIFY_RAW != null && PAY_NOTIFY_RAW != \"\") ? str(PAY_NOTIFY_RAW) : \"" + dflt_notify + "\";\n\n"
    + "post \"" + np + "\", func(req) {\n"
    + "  if (get(req, \"body\", null) == null) { return pay.notify_fail(\"empty body\"); }\n"
    + "  let data = json(req.body);\n"
    + "  if (data == null) { return pay.notify_fail(\"invalid json\"); }\n"
    + "  // 沙箱约定：签名材料随 body（真实 v3 走 Wechatpay-* 响应头，见 S7）\n"
    + "  let ts = str(get(data, \"verify_ts\", \"\"));\n"
    + "  let nonce = str(get(data, \"verify_nonce\", \"\"));\n"
    + "  let sign = str(get(data, \"verify_sign\", \"\"));\n"
    + "  let payload = str(get(data, \"payload\", \"\"));\n"
    + "  if (!pay.verify_notify(str(get(PAY_CFG, \"secret\", \"\")), ts, nonce, payload, sign)) {\n"
    + "    return pay.notify_fail(\"signature mismatch\");\n"
    + "  }\n"
    + "  let evt = json(payload);\n"
    + "  if (evt == null) { return pay.notify_fail(\"invalid payload\"); }\n"
    + "  let order_no = str(get(evt, \"out_trade_no\", \"\"));\n"
    + "  if (order_no == \"\") { return pay.notify_fail(\"missing out_trade_no\"); }\n"
    + "  // 幂等：仅 pending -> paid；重复通知（已流转）回 SUCCESS，防网关重试风暴\n"
    + "  let cur = sql_query(db.dsn(), \"" + sel_st + "\", [order_no]);\n"
    + "  if (len(cur) > 0 && str(get(cur[0], \"" + stf + "\", \"\")) == \"paid\") { return pay.notify_ok(); }\n"
    + "  sql_write(db.dsn(), \"" + upd_st + "\", [order_no]);\n"
    + "  return pay.notify_ok();\n"
    + "};\n\n"
    + "post \"/api/pay/create\", func(req) {\n"
    + "  if (get(req, \"body\", null) == null) { return { \"status\": 400, \"body\": { \"err\": \"empty body\" } }; }\n"
    + "  let data = json(req.body);\n"
    + "  if (data == null) { return { \"status\": 400, \"body\": { \"err\": \"invalid json body\" } }; }\n"
    + "  let order_no = str(get(data, \"order_no\", \"\"));\n"
    + "  if (order_no == \"\") { return { \"status\": 400, \"body\": { \"err\": \"missing order_no\" } }; }\n"
    + "  let rows = sql_query(db.dsn(), \"" + sel_amt + "\", [order_no]);\n"
    + "  if (len(rows) == 0) { return { \"status\": 404, \"body\": { \"err\": \"order not found\" } }; }\n"
    + "  let cents = int(get(rows[0], \"" + amf + "\", 0));\n"
    + "  let r = pay.create_native(PAY_CFG, order_no, cents, \"订单 \" + order_no, PAY_NOTIFY_URL);\n"
    + "  if (get(r, \"ok\", false) != true) {\n"
    + "    return { \"status\": 502, \"body\": { \"err\": \"gateway error\", \"detail\": str(get(r, \"err\", \"\")) } };\n"
    + "  }\n"
    + "  return { \"status\": 200, \"body\": { \"ok\": true, \"code_url\": str(get(r, \"code_url\", \"\")) } };\n"
    + "};\n";
  return b;
}

// PayPal 支付接线块（provider: paypal）：OAuth2 建单 + 跳转 + 返回捕获。
// 与微信同口径：client_id 来自配置（公开标识），client_secret 走 env（secret_env），
// gw 可被 PAY_GATEWAY 覆盖，return/cancel 基址走 PAYPAL_RETURN_URL（默认 127.0.0.1:8081）。
// 创建接口返回 JSON { ok, approve_url, paypal_order_id }（前端据此 window.location 跳转）；
// PayPal 跳回 return?token=<pp_order_id>&order_no=<本地单号> 后服务端捕获并改状态。
// 真实 PayPal 的差距（已知边界，见 README「支付」节 S7/PayPal）：
//   - webhook 验签真实为 HMAC(crc32(body))，本库简化为纯 HMAC（沙箱够用）；
//   - 返回/回调走 query_params（core 的 req.query_params 已解析），不依赖请求头。
func gen_paypal_block(pay): string {
  let mode = str(get(pay, "mode", "sandbox"));
  let client_id = str(get(pay, "client_id", ""));
  let secret_env = str(get(pay, "secret_env", "PAYPAL_KEY"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let currency = str(get(pay, "currency", "USD"));
  let brand = str(get(pay, "brand", "lume-nsgm"));
  let wpath = str(get(pay, "webhook_path", ""));
  let dflt_ret = "http://127.0.0.1:8081";
  // SQL 片段（双引号标识符在生成文件里是 \"，故此处用 \\\"）
  let sel_amt = "SELECT \\\"" + amf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let sel_st = "SELECT \\\"" + stf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let upd_st = "UPDATE \\\"" + om + "\\\" SET \\\"" + stf + "\\\" = 'paid' WHERE \\\"" + onf + "\\\" = ?";
  let b = "// ---- PayPal 支付接线（lume-nsgm 生成；client_id 来自配置，client_secret 走环境变量 " + secret_env + "）----\n"
    + "// 与真实 PayPal 的差距：webhook 验签为 HMAC 简化版（真实含 crc32(body)，\n"
    + "// 需 core 补 crc32 内建或外挂 sidecar）；返回/回调走 query_params（req 无 headers\n"
    + "// 暴露）。详见 README「支付」节。\n"
    + "let PAYPAL_CLIENT_ID = \"" + client_id + "\";\n"
    + "let PAYPAL_CLIENT_SECRET_RAW = env(\"" + secret_env + "\");\n"
    + "let PAYPAL_GATEWAY_RAW = env(\"PAY_GATEWAY\");\n"
    + "let PAYPAL_RETURN_RAW = env(\"PAYPAL_RETURN_URL\");\n"
    + "let PAYPAL_CFG = {\n"
    + "  \"gw\": (PAYPAL_GATEWAY_RAW != null && PAYPAL_GATEWAY_RAW != \"\" ? str(PAYPAL_GATEWAY_RAW) : pay.paypal_base_url(\"" + mode + "\")),\n"
    + "  \"client_id\": PAYPAL_CLIENT_ID,\n"
    + "  \"client_secret\": (PAYPAL_CLIENT_SECRET_RAW != null ? str(PAYPAL_CLIENT_SECRET_RAW) : \"\"),\n"
    + "  \"currency\": \"" + currency + "\",\n"
    + "  \"brand\": \"" + brand + "\"\n"
    + "};\n"
    + "let PAYPAL_RETURN_BASE = (PAYPAL_RETURN_RAW != null && PAYPAL_RETURN_RAW != \"\") ? str(PAYPAL_RETURN_RAW) : \"" + dflt_ret + "\";\n\n"
    // ---- post /api/pay/create：建单，返回 approve_url（前端跳转）----
    + "post \"/api/pay/create\", func(req) {\n"
    + "  if (get(req, \"body\", null) == null) { return { \"status\": 400, \"body\": { \"err\": \"empty body\" } }; }\n"
    + "  let data = json(req.body);\n"
    + "  if (data == null) { return { \"status\": 400, \"body\": { \"err\": \"invalid json body\" } }; }\n"
    + "  let order_no = str(get(data, \"order_no\", \"\"));\n"
    + "  if (order_no == \"\") { return { \"status\": 400, \"body\": { \"err\": \"missing order_no\" } }; }\n"
    + "  let rows = sql_query(db.dsn(), \"" + sel_amt + "\", [order_no]);\n"
    + "  if (len(rows) == 0) { return { \"status\": 404, \"body\": { \"err\": \"order not found\" } }; }\n"
    + "  let cents = int(get(rows[0], \"" + amf + "\", 0));\n"
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) { return { \"status\": 502, \"body\": { \"err\": \"paypal token failed\", \"detail\": str(get(tk, \"err\", \"\")) } }; }\n"
    + "  let return_url = PAYPAL_RETURN_BASE + \"/api/pay/return?order_no=\" + order_no;\n"
    + "  let cancel_url = PAYPAL_RETURN_BASE + \"/api/pay/cancel?order_no=\" + order_no;\n"
    + "  let cr = pay.paypal_create(PAYPAL_CFG, str(get(tk, \"token\", \"\")), order_no, cents, \"Order \" + order_no, return_url, cancel_url);\n"
    + "  if (get(cr, \"ok\", false) != true) { return { \"status\": 502, \"body\": { \"err\": \"paypal create failed\", \"detail\": str(get(cr, \"err\", \"\")) } }; }\n"
    + "  return { \"status\": 200, \"body\": { \"ok\": true, \"approve_url\": str(get(cr, \"approve_url\", \"\")), \"paypal_order_id\": str(get(cr, \"paypal_order_id\", \"\")) } };\n"
    + "};\n\n"
    // ---- get /api/pay/return：PayPal 跳回，捕获并改状态（幂等）----
    + "get \"/api/pay/return\", func(req) {\n"
    + "  let order_no = str(get(req.query_params, \"order_no\", \"\"));\n"
    + "  let pptoken = str(get(req.query_params, \"token\", \"\"));\n"
    + "  if (order_no == \"\" || pptoken == \"\") { return ui.page(\"支付返回\", \"\", \"<p>参数缺失</p>\"); }\n"
    + "  let cur = sql_query(db.dsn(), \"" + sel_st + "\", [order_no]);\n"
    + "  if (len(cur) > 0 && str(get(cur[0], \"" + stf + "\", \"\")) == \"paid\") {\n"
    + "    return ui.page(\"支付成功\", \"\", \"<p>订单 \" + ui.esc(order_no) + \" 已支付。</p>\");\n"
    + "  }\n"
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) { return ui.page(\"支付失败\", \"\", \"<p>获取 PayPal 令牌失败</p>\"); }\n"
    + "  let cap = pay.paypal_capture(PAYPAL_CFG, str(get(tk, \"token\", \"\")), pptoken);\n"
    + "  if (get(cap, \"ok\", false) != true) { return ui.page(\"支付失败\", \"\", \"<p>捕获失败：\" + ui.esc(str(get(cap, \"err\", \"\"))) + \"</p>\"); }\n"
    + "  sql_write(db.dsn(), \"" + upd_st + "\", [order_no]);\n"
    + "  return ui.page(\"支付成功\", \"\", \"<p>订单 \" + ui.esc(order_no) + \" 已支付。</p>\");\n"
    + "};\n\n"
    // ---- get /api/pay/cancel：用户取消 ----
    + "get \"/api/pay/cancel\", func(req) {\n"
    + "  let order_no = str(get(req.query_params, \"order_no\", \"\"));\n"
    + "  return ui.page(\"支付取消\", \"\", \"<p>订单 \" + (order_no != \"\" ? ui.esc(order_no) : \"\") + \" 已取消。</p>\");\n"
    + "};\n\n"
    // ---- post /api/pay/webhook：可选，简化 HMAC 验签（webhook_path 配置时生成）----
    + (wpath != "" ?
        "post \"" + wpath + "\", func(req) {\n"
      + "  let data = json(req.body);\n"
      + "  if (data == null) { return { \"status\": 400, \"body\": { \"err\": \"invalid json\" } }; }\n"
      + "  let id = str(get(data, \"verify_id\", \"\"));\n"
      + "  let ts = str(get(data, \"verify_ts\", \"\"));\n"
      + "  let sign = str(get(data, \"verify_sign\", \"\"));\n"
      + "  let payload = str(get(data, \"payload\", \"\"));\n"
      + "  if (!pay.paypal_verify_webhook(str(get(PAYPAL_CFG, \"client_secret\", \"\")), id, ts, payload, sign)) {\n"
      + "    return { \"status\": 401, \"body\": { \"err\": \"signature mismatch\" } };\n"
      + "  }\n"
      + "  return { \"status\": 200, \"body\": { \"ok\": true } };\n"
      + "};\n" : "");
  return b;
}

// 生成店面接线块（config.shop 存在且 pay 非 null 时注入 app.lume）：
//   get /shop（商品列表，空表自动播种演示数据）+ get /shop/buy/:id（下单 pending）
//   + get /shop/pay/:ono（收银台：微信 code_url / PayPal approve_url）
//   + get /shop/mock-pay/:ono（仅微信：让 mock 网关代投递签名回调，demo 专用）
//   + get /shop/result/:ono（支付结果）。
// 依赖同一 app.lume 里支付接线块的模块级 PAY_CFG/PAY_NOTIFY_URL（微信）或
// PAYPAL_CFG/PAYPAL_RETURN_BASE（PayPal），故 shop 必须与 pay 同时配置。
// 生成店面接线块（config.shop 存在且 pay 非 null 时注入 app.lume）：
//   get /shop（商品列表，空表自动播种演示数据）+ /shop/buy/:id（下单 pending）
//   + /shop/pay/:ono（收银台：微信 code_url / PayPal approve_url）
//   + /shop/mock-pay/:ono（仅微信：mock 网关代投递签名回调，demo 专用）
//   + /shop/result/:ono（支付结果）。
// 依赖同一 app.lume 里支付接线块的模块级 PAY_CFG/PAY_NOTIFY_URL（微信）或
// PAYPAL_CFG/PAYPAL_RETURN_BASE（PayPal），故 shop 必须与 pay 同时配置。
// 产物级模板写好后由 replace() 注入配置标识符（均过 validate 白名单），
// 避免逐行手写双层转义（曾在此踩坑：get(p, \"name\") 多一层反斜杠）。
export func gen_shop_block(shop, pay): string {
  let provider = str(get(pay, "provider", "wechat"));
  let pm = str(get(shop, "product_module", "product"));
  let nf = str(get(shop, "name_field", "name"));
  let pf = str(get(shop, "price_field", "price_cents"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let t = ""
    + "// ---- 店面（lume-nsgm 生成：商品列表 -> 下单 -> 收银台 -> 结果页）----\n"
    + "// 幂等：渲染商品列表时为每个商品附带 ik（幂等 Key）。下单 GET /shop/buy/:id?ik= 复用同一笔 pending 单，\n"
    + "// 避免刷新 / 重复点击产生重复订单；下单后直接渲染收银台，不再经 JS 跳转中间页。\n"
    + "func shop_result(ono: string): string {\n"
    + "  let orows = sql_query(db.dsn(), \"SELECT * FROM \\\"__OM__\\\" WHERE \\\"__ONF__\\\" = ?\", [ono]);\n"
    + "  if (len(orows) == 0) { return ui.page(\"支付结果\", \"shop\", \"<div class=\\\"flash err\\\">订单不存在</div><p><a href=\\\"/shop\\\">返回商城</a></p>\"); }\n"
    + "  let st = str(get(orows[0], \"__STF__\", \"\"));\n"
    + "  if (st == \"paid\") {\n"
    + "    return ui.page(\"支付成功\", \"shop\", \"<h1>支付成功</h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 已完成。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a></p>\");\n"
    + "  }\n"
    + "  return ui.page(\"等待支付\", \"shop\", \"<h1>等待支付</h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 状态：\" + ui.esc(st) + \"。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop/pay/\" + ono + \"\\\">去支付</a></p>\");\n"
    + "}\n"
    + "func shop_cashier(ono: string): string {\n"
    + "  let orows = sql_query(db.dsn(), \"SELECT * FROM \\\"__OM__\\\" WHERE \\\"__ONF__\\\" = ?\", [ono]);\n"
    + "  if (len(orows) == 0) { return ui.page(\"支付\", \"shop\", \"<div class=\\\"flash err\\\">订单不存在</div><p><a href=\\\"/shop\\\">返回商城</a></p>\"); }\n"
    + "  let o = orows[0];\n"
    + "  if (str(get(o, \"__STF__\", \"\")) == \"paid\") { return shop_result(ono); }\n"
    + "  let cents = int(get(o, \"__AMF__\", 0));\n"
  ;
  if (provider == "paypal") {
    t = t + ""
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) {\n"
    + "    return ui.page(\"支付\", \"shop\", \"<div class=\\\"flash err\\\">PayPal 令牌失败：\" + ui.esc(str(get(tk, \"err\", \"\"))) + \"</div>\");\n"
    + "  }\n"
    + "  let return_url = PAYPAL_RETURN_BASE + \"/api/pay/return?order_no=\" + ono;\n"
    + "  let cancel_url = PAYPAL_RETURN_BASE + \"/api/pay/cancel?order_no=\" + ono;\n"
    + "  let r = pay.paypal_create(PAYPAL_CFG, str(get(tk, \"token\", \"\")), ono, cents, \"Shop order \" + ono, return_url, cancel_url);\n"
    + "  if (get(r, \"ok\", false) != true) {\n"
    + "    return ui.page(\"支付\", \"shop\", \"<div class=\\\"flash err\\\">支付网关错误：\" + ui.esc(str(get(r, \"err\", \"\"))) + \"</div><p><a href=\\\"/shop/pay/\" + ono + \"\\\">重试</a></p>\");\n"
    + "  }\n"
    + "  let body = \"<h1>收银台</h1>\\n<p>订单 <code>\" + ui.esc(ono) + \"</code> · 金额 <strong>$\" + pay.fmt_cents(cents) + \"</strong></p>\\n\"\n"
    + "    + \"<p><a class=\\\"btn primary\\\" href=\\\"\" + ui.esc(str(get(r, \"approve_url\", \"\"))) + \"\\\">前往 PayPal 支付</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/result/\" + ono + \"\\\">查询支付结果</a></p>\\n\";\n"
    + "  return ui.page(\"收银台\", \"shop\", body);\n"
      ;
  } else {
    t = t + ""
    + "  let r = pay.create_native(PAY_CFG, ono, cents, \"商城订单 \" + ono, PAY_NOTIFY_URL);\n"
    + "  if (get(r, \"ok\", false) != true) {\n"
    + "    return ui.page(\"支付\", \"shop\", \"<div class=\\\"flash err\\\">支付网关错误：\" + ui.esc(str(get(r, \"err\", \"\"))) + \"</div><p><a href=\\\"/shop/pay/\" + ono + \"\\\">重试</a></p>\");\n"
    + "  }\n"
    + "  let body = \"<h1>收银台</h1>\\n<p>订单 <code>\" + ui.esc(ono) + \"</code> · 金额 <strong>¥\" + pay.fmt_cents(cents) + \"</strong></p>\\n\"\n"
    + "    + \"<p>微信扫码支付（mock）：</p><p><code>\" + ui.esc(str(get(r, \"code_url\", \"\"))) + \"</code></p>\\n\"\n"
    + "    + \"<p><a class=\\\"btn primary\\\" href=\\\"/shop/mock-pay/\" + ono + \"\\\">模拟支付成功（demo）</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/result/\" + ono + \"\\\">查询支付结果</a></p>\\n\";\n"
    + "  return ui.page(\"收银台\", \"shop\", body);\n"
      ;
  }
  t = t + "}\n"
    + "get \"/shop\", func(req) {\n"
    + "  let prows = sql_query(db.dsn(), \"SELECT * FROM \\\"__PM__\\\" ORDER BY \\\"id\\\"\", []);\n"
    + "  if (len(prows) == 0) {\n"
    + "    sql_write(db.dsn(), \"INSERT INTO \\\"__PM__\\\" (\\\"__NF__\\\", \\\"__PF__\\\") VALUES (?, ?)\", [\"Lume 机械键盘\", 39900]);\n"
    + "    sql_write(db.dsn(), \"INSERT INTO \\\"__PM__\\\" (\\\"__NF__\\\", \\\"__PF__\\\") VALUES (?, ?)\", [\"lume 主题卫衣\", 19900]);\n"
    + "    sql_write(db.dsn(), \"INSERT INTO \\\"__PM__\\\" (\\\"__NF__\\\", \\\"__PF__\\\") VALUES (?, ?)\", [\"程序员马克杯\", 5900]);\n"
    + "    prows = sql_query(db.dsn(), \"SELECT * FROM \\\"__PM__\\\" ORDER BY \\\"id\\\"\", []);\n"
    + "  }\n"
    + "  let body = \"<h1>商城</h1>\\n<p class=\\\"muted\\\">演示店面：点「购买」下单，收银台完成支付，回调自动落库。</p>\\n\";\n"
    + "  let i = 0;\n"
    + "  while (i < len(prows)) {\n"
    + "    let p = prows[i];\n"
    + "    let ik = str(get(p, \"id\", 0)) + \"-\" + str(now());\n"
    + "    body = body + \"<div class=\\\"card\\\"><h3>\" + ui.esc(str(get(p, \"__NF__\", \"\"))) + \"</h3>\\n\"\n"
    + "      + \"<p class=\\\"price\\\">¥\" + pay.fmt_cents(int(get(p, \"__PF__\", 0))) + \"</p>\\n\"\n"
    + "      + \"<p class=\\\"muted\\\">\" + ui.esc(str(get(p, \"detail\", \"\"))) + \"</p>\\n\"\n"
    + "      + \"<a class=\\\"btn primary\\\" href=\\\"/shop/buy/\" + str(get(p, \"id\", 0)) + \"?ik=\" + ik + \"\\\">购买</a></div>\\n\";\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return ui.page(\"商城\", \"shop\", body);\n"
    + "};\n"
    + "get \"/shop/buy/:id\", func(req) {\n"
    + "  let pid = db.qs_int(req.params, \"id\", 0);\n"
    + "  let ik = str(get(req.query_params, \"ik\", \"\"));\n"
    + "  if (ik == \"\") { ik = str(pid) + \"-\" + str(now()); }\n"
    + "  let ono = \"SHOP-\" + ik;\n"
    + "  let prows = sql_query(db.dsn(), \"SELECT * FROM \\\"__PM__\\\" WHERE \\\"id\\\" = ?\", [pid]);\n"
    + "  if (len(prows) == 0) { return ui.page(\"商城\", \"shop\", \"<div class=\\\"flash err\\\">商品不存在</div><p><a href=\\\"/shop\\\">返回商城</a></p>\"); }\n"
    + "  let p = prows[0];\n"
    + "  let ex = sql_query(db.dsn(), \"SELECT * FROM \\\"__OM__\\\" WHERE \\\"__ONF__\\\" = ?\", [ono]);\n"
    + "  if (len(ex) > 0) {\n"
    + "    if (str(get(ex[0], \"__STF__\", \"\")) == \"paid\") { ono = ono + \"-r\" + str(now()); }\n"
    + "    else { return shop_cashier(ono); }\n"
    + "  }\n"
    + "  sql_write(db.dsn(), \"INSERT INTO \\\"__OM__\\\" (\\\"__ONF__\\\", \\\"__AMF__\\\", \\\"__STF__\\\") VALUES (?, ?, 'pending')\", [ono, int(get(p, \"__PF__\", 0))]);\n"
    + "  return shop_cashier(ono);\n"
    + "};\n"
    + "get \"/shop/pay/:ono\", func(req) {\n"
    + "  let ono = str(get(req.params, \"ono\", \"\"));\n"
    + "  return shop_cashier(ono);\n"
    + "};\n"
    + "// demo 专用：让 mock 网关代投递签名回调（真实环境由微信服务器打 notify）\n"
    + "get \"/shop/mock-pay/:ono\", func(req) {\n"
    + "  let ono = str(get(req.params, \"ono\", \"\"));\n"
    + "  let orows = sql_query(db.dsn(), \"SELECT * FROM \\\"__OM__\\\" WHERE \\\"__ONF__\\\" = ?\", [ono]);\n"
    + "  if (len(orows) == 0) { return ui.page(\"支付\", \"shop\", \"<div class=\\\"flash err\\\">订单不存在</div>\"); }\n"
    + "  let cents = int(get(orows[0], \"__AMF__\", 0));\n"
    + "  let nb = stringify({ \"notify_url\": PAY_NOTIFY_URL, \"order_no\": ono, \"amount_cents\": cents });\n"
    + "  http_post(str(get(PAY_CFG, \"gw\", \"\")) + \"/mock/notify\", { \"headers\": { \"Content-Type\": \"application/json\" }, \"body\": nb, \"allow_private\": true, \"timeout\": 10 });\n"
    + "  return shop_result(ono);\n"
    + "};\n"
    + "get \"/shop/result/:ono\", func(req) {\n"
    + "  let ono = str(get(req.params, \"ono\", \"\"));\n"
    + "  return shop_result(ono);\n"
    + "};\n"
    ;
  // 占位符统一在拼接完成后替换（分支/尾部模板同样带占位符）
  t = replace(t, "__PM__", pm);
  t = replace(t, "__NF__", nf);
  t = replace(t, "__PF__", pf);
  t = replace(t, "__OM__", om);
  t = replace(t, "__ONF__", onf);
  t = replace(t, "__AMF__", amf);
  t = replace(t, "__STF__", stf);
  return t;
}

// 生成 app.lume 入口：server 块 + 模块装配（import 即注册路由）+ 建表 + run()
// 顺序对照 lume 仓 examples/demo.lume：server{} -> routes(经 import) -> run()
// pay 为 config.pay（validate_pay 已过）或 null；非 null 时注入支付接线块。
export func gen_app_entry(out: string, mods, pay, shop): int {
  let imports = "";
  let ddl_args = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      imports = imports + "import \"modules/" + name + ".lume\" as " + name + ";\n";
      if (ddl_args != "") { ddl_args = ddl_args + ", "; }
      ddl_args = ddl_args + "{ \"name\": " + name + ".TBL, \"ddl\": " + name + ".DDL, \"cols\": " + name + ".COLS }";
    }
    i = i + 1;
  }
  if (pay != null) {
    imports = imports + "import \"lib/pay.lume\" as pay;\n";
  }
  let content = "// app.lume — lume-nsgm 生成入口（勿手改）\n"
    + "// 运行：lume-core app.lume  （lume-core 0.7.0+ 自带 server/route/run、sql 内建与 docroot 静态）\n"
    + "// 端口/host/workers 从环境变量读取（PORT/HOST/WORKERS），未设置时用下方默认值。\n"
    + "// 注：env() 在 server{} 中生效需默认（解释器）后端；Docker 构建已强制 HAVE_LLVM=0。\n"
    + "server {\n"
    + "  port = (env(\"PORT\") != null && env(\"PORT\") != \"\") ? int(env(\"PORT\")) : 8081;\n"
    + "  host = (env(\"HOST\") != null && env(\"HOST\") != \"\") ? env(\"HOST\") : \"127.0.0.1\";\n"
    + "  workers = (env(\"WORKERS\") != null && env(\"WORKERS\") != \"\") ? int(env(\"WORKERS\")) : 4;\n"
    + "  docroot = \"./www\";\n}\n\n"
    + "import \"lib/ui.lume\" as ui;\n"
    + "import \"lib/db.lume\" as db;\n"
    + imports
    + "\n// 首次启动自动建表（CREATE TABLE IF NOT EXISTS），并对已有表补齐新增列（迁移）\n"
    + "db.init([" + ddl_args + "]);\n\n"
    + (pay != null ? gen_pay_block(pay) + "\n" : "")
    + (pay != null && shop != null ? gen_shop_block(shop, pay) + "\n" : "")
    + "// 首页导航\n"
    + "get \"/\", func(req) {\n"
    + "  let body = \"<h1>lume-nsgm 生成的项目</h1>\\n<ul>\\n\";\n";
  i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      content = content + "  body = body + \"  <li><a href=/" + name + ">" + name + "</a></li>\\n\";\n";
    }
    i = i + 1;
  }
  content = content + (pay != null && shop != null ? "  body = body + \"  <li><a href=/shop>商城（店面演示）</a></li>\\n\";\n" : "")
    + "  body = body + \"</ul>\\n\";\n"
    + "  return ui.page(\"首页\", \"\", body);\n"
    + "};\n\n"
    + "run();\n";
  write_file(out + "/app.lume", content);
  return 0;
}

// 串联：建目录 -> 复制静态基座 -> ui.lume -> app.lume -> web/ React 前端
// pay 为 config.pay（或 null）；非 null 时 app.lume 注入支付接线（见 gen_pay_block）
// shop 为 config.shop（或 null）；pay+shop 同时非 null 时注入店面（见 gen_shop_block）
export func base_project(out: string, mods, pay, shop): int {
  mkdir(out);
  mkdir(out + "/lib");
  mkdir(out + "/modules");
  mkdir(out + "/sql");
  mkdir(out + "/www");
  mkdir(out + "/data");

  copy_base(out);
  gen_ui(out, mods, shop);
  gen_app_entry(out, mods, pay, shop);
  rg.gen_web(out, mods);
  return 0;
}
