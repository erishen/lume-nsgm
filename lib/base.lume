// base.lume — 输出以 lume 为底的可运行工程（app.lume + lib + modules + www + web）
// 与 lib/scaffold.lume 的 write_tree 配合：write_tree 写 modules/<ctrl>.lume
// 与 sql/<ctrl>.sql，本文件负责复制静态基座、生成 lib/ui.lume（NAV 注入）、
// app.lume 入口与 web/ React 前端（Vite + React + TS，经 lib/reactgen.lume）。
import "model.lume" as m;
import "reactgen.lume" as rg;
import "tpl.lume" as tpl;

// 需要从 scaffold/ 复制的静态文件（路径相对于生成根 out）
let STATIC_FILES = [
  "lib/db.lume",
  "lib/pay.lume",
  "www/app.css",
  "www/app.js",
  "README.run.md"
];

// 复制静态基座文件（scaffold/ -> out/）
export func copy_base(out: string): int {
  let i = 0;
  while (i < len(STATIC_FILES)) {
    let f = STATIC_FILES[i];
    let content = read_file("scaffold/" + f);
    if (content != null) {
      write_file(out + "/" + f, content);
    } else {
      print("WARN: scaffold/" + f + " missing");
    }
    i = i + 1;
  }
  return 0;
}

// 生成 lib/ui.lume：SSR 组件库，NAV 由模块清单注入（shop 非 null 时加商城入口）。
// 注：全量 SPA 后页面改由 /spa/ 下 React 渲染，ui.lume 仅作历史兼容保留（默认不再调用）。
export func gen_ui(out: string, mods, shop): int {
  let nav_rows = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      let label = get(mod, "label", name);
      nav_rows = nav_rows + "  [\"" + name + "\", \"" + label + "\"],\n";
    }
    i = i + 1;
  }
  if (shop != null) {
    nav_rows = nav_rows + "  [\"shop\", \"商城\"],\n";
  }
  let content = "// lib/ui.lume — SSR 组件库（lume-nsgm 生成：NAV 为模块清单）\n"
    + "let NAV = [\n" + nav_rows + "];\n\n"
    + "export func esc(s): string {\n"
    + "  let out = str(s);\n"
    + "  out = replace(out, \"&\", \"&amp;\");\n"
    + "  out = replace(out, \"<\", \"&lt;\");\n"
    + "  out = replace(out, \">\", \"&gt;\");\n"
    + "  out = replace(out, \"\\\"\", \"&quot;\");\n"
    + "  return out;\n"
    + "}\n\n"
    + "export func nav(active: string): string {\n"
    + "  let out = \"<header class=\\\"nav\\\"><a class=\\\"brand\\\" href=\\\"/\\\">lume-nsgm</a>\";\n"
    + "  let i = 0;\n"
    + "  while (i < len(NAV)) {\n"
    + "    let item = NAV[i];\n"
    + "    let cls = \"\";\n"
    + "    if (item[0] == active) { cls = \" class=\\\"active\\\"\"; }\n"
    + "    out = out + \"<a\" + cls + \" href=\\\"/\" + item[0] + \"\\\">\" + esc(item[1]) + \"</a>\";\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return out + \"</header>\";\n"
    + "}\n\n"
    + "export func page(title: string, active: string, body: string): string {\n"
    + "  return \"<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n\"\n"
    + "    + \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"\n"
    + "    + \"<title>\" + esc(title) + \"</title>\\n\"\n"
    + "    + \"<link rel=\\\"stylesheet\\\" href=\\\"/app.css\\\">\\n\"\n"
    + "    + \"<script src=\\\"/app.js\\\" defer></script>\\n</head>\\n<body>\\n\"\n"
    + "    + nav(active)\n"
    + "    + \"<main class=\\\"container\\\">\\n\" + body + \"</main>\\n\"\n"
    + "    + \"<footer class=\\\"foot\\\">lume-nsgm · 演示电商店面</footer>\\n</body>\\n</html>\\n\";\n"
    + "}\n";
  write_file(out + "/lib/ui.lume", content);
  return 0;
}

// PayPal 支付接线块：OAuth2 建单 + 跳转 + 返回捕获（全量 SPA：只出 JSON API）。
// client_id 来自配置（公开标识），client_secret 走 env（secret_env），
// gw 可被 PAY_GATEWAY 覆盖；return/cancel 基址默认跟随 server 实际监听地址（HOST:PORT），
// 仅当 PAYPAL_RETURN_URL 显式设置时（如 docker/反代：发布端口≠监听端口）才覆盖。
// 创建接口返回 JSON { ok, approve_url, paypal_order_id }；收银台与 /api/shop/cashier 复用；
// PayPal 跳回 return?token=<pp_order_id>&order_no=<本地单号> 后服务端捕获并改状态，
// 回跳地址走 /spa/ hash 路由（前端接管展示，后端无需 fallback）。
func gen_paypal_block(pay): string {
  let mode = str(get(pay, "mode", "sandbox"));
  let client_id = str(get(pay, "client_id", ""));
  let secret_env = str(get(pay, "secret_env", "PAYPAL_KEY"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let currency = str(get(pay, "currency", "USD"));
  let csym = str(get(pay, "currency_symbol", "$"));
  let brand = str(get(pay, "brand", "lume-nsgm"));
  let wpath = str(get(pay, "webhook_path", ""));
  // 捕获回填列（与 gen_shop_block 同默认）：return 处理器 UPDATE 订单行时用
  let ppidf = str(get(pay, "paypal_order_field", "paypal_order_id"));
  let capf = str(get(pay, "capture_id_field", "capture_id"));
  let ctx = {
    "mode": mode,
    "client_id": client_id,
    "secret_env": secret_env,
    "om": om,
    "onf": onf,
    "amf": amf,
    "stf": stf,
    "currency": currency,
    "csym": csym,
    "brand": brand,
    "webhook_path": wpath,
    "ppidf": ppidf,
    "capf": capf,
    "has_webhook": (wpath != "" ? "1" : "0")
  };
  let tpl_text = read_file("templates/pay_block.lume.tpl");
  if (tpl_text == null) { return "// ERROR: templates/pay_block.lume.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 生成店面接线块（config.shop 存在且 pay 非 null 时注入 app.lume）：
// /api/shop/products（列表+播种+清空）、/api/shop/buy（下单）、/api/shop/cashier（收银台，复用以防孤儿单）、
// /api/shop/result（结果）、/api/shop/refund（确认数据 GET + 执行 POST，含退款反查/本地标记）。
// 全部 JSON API；页面由 /spa/ 下 React 渲染。依赖同一 app.lume 里支付块的 PAYPAL_CFG/PAYPAL_RETURN_BASE。
export func gen_shop_block(shop, pay): string {
  let pm = str(get(shop, "product_module", "product"));
  let nf = str(get(shop, "name_field", "name"));
  let pf = str(get(shop, "price_field", "price_cents"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  // 退款关联列（PayPal 分支用）：捕获回填 paypal_order_id/capture_id，退款凭 capture_id 退
  let ppidf = str(get(pay, "paypal_order_field", "paypal_order_id"));
  let capf = str(get(pay, "capture_id_field", "capture_id"));
  // 商品快照/库存（可选）：prdf=订单行商品 id 列；pnmf=商品名快照列；skf=商品行库存列
  let prdf = str(get(shop, "product_field", ""));
  let pnmf = str(get(shop, "product_name_field", ""));
  let skf = str(get(shop, "stock_field", ""));
  let has_pref = (prdf != "" ? "1" : "0");
  let has_name = (pnmf != "" ? "1" : "0");
  let has_stock = (skf != "" && prdf != "" ? "1" : "0");
  let ctx = {
    "pm": pm, "nf": nf, "pf": pf, "om": om, "onf": onf, "amf": amf, "stf": stf,
    "ppidf": ppidf, "capf": capf, "prdf": prdf, "pnmf": pnmf, "skf": skf,
    "csym": str(get(pay, "currency_symbol", "$")),
    "has_pref": has_pref, "has_name": has_name, "has_stock": has_stock
  };
  let tpl_text = read_file("templates/shop_block.lume.tpl");
  if (tpl_text == null) { return "// ERROR: templates/shop_block.lume.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 生成购物车接线块（P2-4，与店面同时注入）：落库购物车 + session 存 cart_id。
// ctx 复用店面的模块/字段绑定（pm/nf/pf/om/onf/amf/stf/prdf/pnmf/skf/csym/
// has_pref/has_name/has_stock），模板另需 ppidf/capf。
export func gen_cart_block(shop, pay): string {
  let pm = str(get(shop, "product_module", "product"));
  let nf = str(get(shop, "name_field", "name"));
  let pf = str(get(shop, "price_field", "price_cents"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let ppidf = str(get(pay, "paypal_order_field", "paypal_order_id"));
  let capf = str(get(pay, "capture_id_field", "capture_id"));
  let prdf = str(get(shop, "product_field", ""));
  let pnmf = str(get(shop, "product_name_field", ""));
  let skf = str(get(shop, "stock_field", ""));
  let has_pref = (prdf != "" ? "1" : "0");
  let has_name = (pnmf != "" ? "1" : "0");
  let has_stock = (skf != "" && prdf != "" ? "1" : "0");
  let ctx = {
    "pm": pm, "nf": nf, "pf": pf, "om": om, "onf": onf, "amf": amf, "stf": stf,
    "ppidf": ppidf, "capf": capf, "prdf": prdf, "pnmf": pnmf, "skf": skf,
    "csym": str(get(pay, "currency_symbol", "$")),
    "has_pref": has_pref, "has_name": has_name, "has_stock": has_stock
  };
  let tpl_text = read_file("templates/cart_block.lume.tpl");
  if (tpl_text == null) { return "// ERROR: templates/cart_block.lume.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 生成 app.lume 入口：server 块 + 模块装配（import 即注册路由）+ 建表 + run()
// 顺序对照 lume 仓 examples/demo.lume：server{} -> routes(经 import) -> run()
// pay 为 config.pay（validate_pay 已过）或 null；非 null 时注入支付接线块。
export func gen_app_entry(out: string, mods, pay, shop): int {
  let imports = "";
  let ddl_args = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      imports = imports + "import \"modules/" + name + ".lume\" as " + name + ";\n";
      if (ddl_args != "") { ddl_args = ddl_args + ", "; }
      ddl_args = ddl_args + "{ \"name\": " + name + ".TBL, \"ddl\": " + name + ".DDL, \"cols\": " + name + ".COLS }";
    }
    i = i + 1;
  }
  // 购物车表（P2-4）：固定 schema，非用户配置模块；经 db.init 建表+迁移。
  // 列/表名均为白名单标识符（无注入面）；DDL 经 replace 转义后内联为 lume 字符串字面量。
  let cart_ddl = "CREATE TABLE IF NOT EXISTS \"cart\" (\"id\" INTEGER PRIMARY KEY, \"status\" TEXT DEFAULT 'active', \"created_at\" TEXT)";
  let cart_item_ddl = "CREATE TABLE IF NOT EXISTS \"cart_item\" (\"id\" INTEGER PRIMARY KEY, \"cart_id\" INTEGER, \"product_id\" INTEGER, \"qty\" INTEGER, \"price_cents\" INTEGER, \"name\" TEXT)";
  if (ddl_args != "") { ddl_args = ddl_args + ", "; }
  ddl_args = ddl_args
    + "{ \"name\": \"cart\", \"ddl\": \"" + replace(cart_ddl, "\"", "\\\"") + "\", \"cols\": [{\"name\":\"id\",\"type_sql\":\"INTEGER\",\"auto\":true},{\"name\":\"status\",\"type_sql\":\"TEXT\"},{\"name\":\"created_at\",\"type_sql\":\"TEXT\"}] }"
    + ", "
    + "{ \"name\": \"cart_item\", \"ddl\": \"" + replace(cart_item_ddl, "\"", "\\\"") + "\", \"cols\": [{\"name\":\"id\",\"type_sql\":\"INTEGER\",\"auto\":true},{\"name\":\"cart_id\",\"type_sql\":\"INTEGER\"},{\"name\":\"product_id\",\"type_sql\":\"INTEGER\"},{\"name\":\"qty\",\"type_sql\":\"INTEGER\"},{\"name\":\"price_cents\",\"type_sql\":\"INTEGER\"},{\"name\":\"name\",\"type_sql\":\"TEXT\"}] }";
  if (pay != null) {
    imports = imports + "import \"lib/pay.lume\" as pay;\n";
  }
  let content = "// app.lume — lume-nsgm 生成入口（勿手改）\n"
    + "// 运行：lume-core app.lume  （lume-core 0.7.0+ 自带 server/route/run、sql 内建与 docroot 静态）\n"
    + "// 端口/host/workers 从环境变量读取（PORT/HOST/WORKERS），未设置时用下方默认值。\n"
    + "// 注：env() 在 server{} 中生效需默认（解释器）后端；Docker 构建已强制 HAVE_LLVM=0。\n"
    + "server {\n"
    + "  port = (env(\"PORT\") != null && env(\"PORT\") != \"\") ? int(env(\"PORT\")) : 8081;\n"
    + "  host = (env(\"HOST\") != null && env(\"HOST\") != \"\") ? env(\"HOST\") : \"127.0.0.1\";\n"
    + "  workers = (env(\"WORKERS\") != null && env(\"WORKERS\") != \"\") ? int(env(\"WORKERS\")) : 4;\n"
    + "  docroot = \"./www\";\n}\n\n"
    + "import \"lib/db.lume\" as db;\n"
    + imports
    + "\n// 首次启动自动建表（CREATE TABLE IF NOT EXISTS），并对已有表补齐新增列（迁移）\n"
    + "db.init([" + ddl_args + "]);\n\n"
    + (pay != null ? gen_paypal_block(pay) + "\n" : "")
    + (pay != null && shop != null ? gen_shop_block(shop, pay) + "\n" + gen_cart_block(shop, pay) + "\n" : "")
    // 首页：全量 SPA，根路径直接引导到 /spa/（SPA 内含店面与管理后台）
    + "get \"/\", func(req) {\n"
    + "  return \"<!DOCTYPE html><html lang=\\\"zh-CN\\\"><head><meta charset=\\\"utf-8\\\"><meta http-equiv=\\\"refresh\\\" content=\\\"0;url=/spa/\\\"><title>lume-nsgm</title></head><body><p>正在进入应用…若未跳转，请<a href=\\\"/spa/\\\">点击这里</a>。</p></body></html>\";\n"
    + "};\n\n"
    + "run();\n";
  write_file(out + "/app.lume", content);
  return 0;
}

// 串联：建目录 -> 复制静态基座 -> ui.lume -> app.lume -> web/ React 前端
// pay 为 config.pay（或 null）；非 null 时 app.lume 注入支付接线（见 gen_paypal_block）
// shop 为 config.shop（或 null）；pay+shop 同时非 null 时注入店面（见 gen_shop_block）
export func base_project(out: string, mods, pay, shop): int {
  mkdir(out);
  mkdir(out + "/lib");
  mkdir(out + "/modules");
  mkdir(out + "/sql");
  mkdir(out + "/www");
  mkdir(out + "/data");

  copy_base(out);
  gen_ui(out, mods, shop);
  gen_app_entry(out, mods, pay, shop);
  rg.gen_web(out, mods, shop, pay);
  return 0;
}
