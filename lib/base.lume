// base.lume — 输出以 lume 为底的可运行工程（app.lume + lib + modules + www + web）
// 与 lib/scaffold.lume 的 write_tree 配合：write_tree 写 modules/<ctrl>.lume
// 与 sql/<ctrl>.sql，本文件负责复制静态基座、生成 lib/ui.lume（NAV 注入）、
// app.lume 入口与 web/ React 前端（Vite + React + TS，经 lib/reactgen.lume）。
import "model.lume" as m;
import "reactgen.lume" as rg;

// 需要从 scaffold/ 复制的静态文件（路径相对于生成根 out）
let STATIC_FILES = [
  "lib/db.lume",
  "lib/pay.lume",
  "www/app.css",
  "www/app.js",
  "README.run.md"
];

// 复制静态基座文件（scaffold/ -> out/）
export func copy_base(out: string): int {
  let i = 0;
  while (i < len(STATIC_FILES)) {
    let f = STATIC_FILES[i];
    let content = read_file("scaffold/" + f);
    if (content != null) {
      write_file(out + "/" + f, content);
    } else {
      print("WARN: scaffold/" + f + " missing");
    }
    i = i + 1;
  }
  return 0;
}

// 生成 lib/ui.lume：SSR 组件库，NAV 由模块清单注入（shop 非 null 时加商城入口）
export func gen_ui(out: string, mods, shop): int {
  let nav_rows = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      let label = get(mod, "label", name);
      nav_rows = nav_rows + "  [\"" + name + "\", \"" + label + "\"],\n";
    }
    i = i + 1;
  }
  if (shop != null) {
    nav_rows = nav_rows + "  [\"shop\", \"商城\"],\n";
  }
  let content = "// lib/ui.lume — SSR 组件库（lume-nsgm 生成：NAV 为模块清单）\n"
    + "let NAV = [\n" + nav_rows + "];\n\n"
    + "export func esc(s): string {\n"
    + "  let out = str(s);\n"
    + "  out = replace(out, \"&\", \"&amp;\");\n"
    + "  out = replace(out, \"<\", \"&lt;\");\n"
    + "  out = replace(out, \">\", \"&gt;\");\n"
    + "  out = replace(out, \"\\\"\", \"&quot;\");\n"
    + "  return out;\n"
    + "}\n\n"
    + "export func nav(active: string): string {\n"
    + "  let out = \"<header class=\\\"nav\\\"><a class=\\\"brand\\\" href=\\\"/\\\">lume-nsgm</a>\";\n"
    + "  let i = 0;\n"
    + "  while (i < len(NAV)) {\n"
    + "    let item = NAV[i];\n"
    + "    let cls = \"\";\n"
    + "    if (item[0] == active) { cls = \" class=\\\"active\\\"\"; }\n"
    + "    out = out + \"<a\" + cls + \" href=\\\"/\" + item[0] + \"\\\">\" + esc(item[1]) + \"</a>\";\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return out + \"</header>\";\n"
    + "}\n\n"
    + "export func page(title: string, active: string, body: string): string {\n"
    + "  return \"<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n\"\n"
    + "    + \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"\n"
    + "    + \"<title>\" + esc(title) + \"</title>\\n\"\n"
    + "    + \"<link rel=\\\"stylesheet\\\" href=\\\"/app.css\\\">\\n\"\n"
    + "    + \"<script src=\\\"/app.js\\\" defer></script>\\n</head>\\n<body>\\n\"\n"
    + "    + nav(active)\n"
    + "    + \"<main class=\\\"container\\\">\\n\" + body + \"</main>\\n\"\n"
    + "    + \"<footer class=\\\"foot\\\">lume-nsgm · 演示电商店面</footer>\\n</body>\\n</html>\\n\";\n"
    + "}\n";
  write_file(out + "/lib/ui.lume", content);
  return 0;
}

// PayPal 支付接线块：OAuth2 建单 + 跳转 + 返回捕获。
// client_id 来自配置（公开标识），client_secret 走 env（secret_env），
// gw 可被 PAY_GATEWAY 覆盖，return/cancel 基址走 PAYPAL_RETURN_URL（默认 127.0.0.1:8081）。
// 创建接口返回 JSON { ok, approve_url, paypal_order_id }（前端据此 window.location 跳转）；
// PayPal 跳回 return?token=<pp_order_id>&order_no=<本地单号> 后服务端捕获并改状态。
// 真实 PayPal 的差距（已知边界，见 README「支付 / Payment」节 S7/PayPal）：
//   - webhook 验签真实为 HMAC(crc32(body))，本库简化为纯 HMAC（沙箱够用）；
//   - 返回/回调走 query_params（core 的 req.query_params 已解析），不依赖请求头。
func gen_paypal_block(pay): string {
  let mode = str(get(pay, "mode", "sandbox"));
  let client_id = str(get(pay, "client_id", ""));
  let secret_env = str(get(pay, "secret_env", "PAYPAL_KEY"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  let currency = str(get(pay, "currency", "USD"));
  let csym = str(get(pay, "currency_symbol", "$"));
  let brand = str(get(pay, "brand", "lume-nsgm"));
  let wpath = str(get(pay, "webhook_path", ""));
  let dflt_ret = "http://127.0.0.1:8081";
  // 退款关联列（可配置，默认与示例配置的 order 模块对齐）：捕获成功后回填，
  // 退款路由凭 capture_id 退；旧订单无回填时由 pay.paypal_get_order 反查兜底。
  let ppidf = str(get(pay, "paypal_order_field", "paypal_order_id"));
  let capf = str(get(pay, "capture_id_field", "capture_id"));
  // SQL 片段（双引号标识符在生成文件里是 \"，故此处用 \\\"）
  let sel_amt = "SELECT \\\"" + amf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let sel_st_amt = "SELECT \\\"" + stf + "\\\", \\\"" + amf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let sel_st = "SELECT \\\"" + stf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let upd_paid_ids = "UPDATE \\\"" + om + "\\\" SET \\\"" + stf + "\\\" = 'paid', \\\"" + ppidf + "\\\" = ?, \\\"" + capf + "\\\" = ? WHERE \\\"" + onf + "\\\" = ?";
  let b = "// ---- PayPal 支付接线（lume-nsgm 生成；client_id 来自配置，client_secret 走环境变量 " + secret_env + "）----\n"
    + "// 与真实 PayPal 的差距：webhook 验签为 HMAC 简化版（真实含 crc32(body)，\n"
    + "// 需 core 补 crc32 内建或外挂 sidecar）；返回/回调走 query_params（req 无 headers\n"
    + "// 暴露）。详见 README「支付 / Payment」节。\n"
    + "let PAYPAL_CLIENT_ID_RAW = env(\"PAYPAL_CLIENT_ID\");\n"
    + "let PAYPAL_CLIENT_ID = (PAYPAL_CLIENT_ID_RAW != null && PAYPAL_CLIENT_ID_RAW != \"\" ? str(PAYPAL_CLIENT_ID_RAW) : \"" + client_id + "\");\n"
    + "let PAYPAL_CLIENT_SECRET_RAW = env(\"" + secret_env + "\");\n"
    + "let PAYPAL_GATEWAY_RAW = env(\"PAY_GATEWAY\");\n"
    + "let PAYPAL_RETURN_RAW = env(\"PAYPAL_RETURN_URL\");\n"
    + "let PAYPAL_CFG = {\n"
    + "  \"gw\": (PAYPAL_GATEWAY_RAW != null && PAYPAL_GATEWAY_RAW != \"\" ? str(PAYPAL_GATEWAY_RAW) : pay.paypal_base_url(\"" + mode + "\")),\n"
    + "  \"client_id\": PAYPAL_CLIENT_ID,\n"
    + "  \"client_secret\": (PAYPAL_CLIENT_SECRET_RAW != null ? str(PAYPAL_CLIENT_SECRET_RAW) : \"\"),\n"
    + "  \"currency\": \"" + currency + "\",\n"
    + "  \"brand\": \"" + brand + "\"\n"
    + "};\n"
    + "let PAYPAL_RETURN_BASE = (PAYPAL_RETURN_RAW != null && PAYPAL_RETURN_RAW != \"\") ? str(PAYPAL_RETURN_RAW) : \"" + dflt_ret + "\";\n"
    + "let csym = \"" + csym + "\";\n\n"
    // ---- post /api/pay/create：建单，返回 approve_url（前端跳转）----
    + "post \"/api/pay/create\", func(req) {\n"
    + "  if (get(req, \"body\", null) == null) { return { \"status\": 400, \"body\": { \"err\": \"empty body\" } }; }\n"
    + "  let data = json(req.body);\n"
    + "  if (data == null) { return { \"status\": 400, \"body\": { \"err\": \"invalid json body\" } }; }\n"
    + "  let order_no = str(get(data, \"order_no\", \"\"));\n"
    + "  if (order_no == \"\") { return { \"status\": 400, \"body\": { \"err\": \"missing order_no\" } }; }\n"
    + "  let rows = sql_query(db.dsn(), \"" + sel_amt + "\", [order_no]);\n"
    + "  if (len(rows) == 0) { return { \"status\": 404, \"body\": { \"err\": \"order not found\" } }; }\n"
    + "  let cents = int(get(rows[0], \"" + amf + "\", 0));\n"
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) { return { \"status\": 502, \"body\": { \"err\": \"paypal token failed\", \"detail\": str(get(tk, \"err\", \"\")) } }; }\n"
    + "  let return_url = PAYPAL_RETURN_BASE + \"/api/pay/return?order_no=\" + order_no;\n"
    + "  let cancel_url = PAYPAL_RETURN_BASE + \"/api/pay/cancel?order_no=\" + order_no;\n"
    + "  let cr = pay.paypal_create(PAYPAL_CFG, str(get(tk, \"token\", \"\")), order_no, cents, \"Order \" + order_no, return_url, cancel_url);\n"
    + "  if (get(cr, \"ok\", false) != true) { return { \"status\": 502, \"body\": { \"err\": \"paypal create failed\", \"detail\": str(get(cr, \"err\", \"\")) } }; }\n"
    + "  return { \"status\": 200, \"body\": { \"ok\": true, \"approve_url\": str(get(cr, \"approve_url\", \"\")), \"paypal_order_id\": str(get(cr, \"paypal_order_id\", \"\")) } };\n"
    + "};\n\n"
    // ---- get /api/pay/return：PayPal 跳回，捕获并改状态（幂等）----
    + "get \"/api/pay/return\", func(req) {\n"
    + "  let order_no = str(get(req.query_params, \"order_no\", \"\"));\n"
    + "  let pptoken = str(get(req.query_params, \"token\", \"\"));\n"
    + "  if (order_no == \"\" || pptoken == \"\") { return ui.page(\"支付返回\", \"\", \"<p>参数缺失</p>\"); }\n"
    + "  let cur = sql_query(db.dsn(), \"" + sel_st_amt + "\", [order_no]);\n"
    + "  // 订单存在性检查：未知单号不进捕获流程（否则捕获成功也只会 UPDATE 0 行，\n"
    + "  // 却给用户看成功页——PayPal 侧真实扣过款的单对不上本地单的事故路径）\n"
    + "  if (len(cur) == 0) { return ui.page(\"支付失败\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付失败 <span class=\\\"badge\\\">PayPal</span></h1><div class=\\\"flash err\\\">订单 \" + ui.esc(order_no) + \" 不存在</div><p><a class=\\\"btn ghost\\\" href=\\\"/shop\\\">返回商城</a></p></div>\"); }\n"
    + "  let cents = int(get(cur[0], \"" + amf + "\", 0));\n"
    + "  if (str(get(cur[0], \"" + stf + "\", \"\")) == \"paid\") {\n"
    + "    return ui.page(\"支付成功\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付成功 <span class=\\\"badge\\\">PayPal</span></h1><p>订单 <code>\" + ui.esc(order_no) + \"</code> · 金额 <strong>\" + csym + \"\" + pay.fmt_cents(cents) + \"</strong> 已支付。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/refund/\" + ui.esc(order_no) + \"\\\">申请退款</a></p></div>\");\n"
    + "  }\n"
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) { return ui.page(\"支付失败\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付失败 <span class=\\\"badge\\\">PayPal</span></h1><p>获取 PayPal 令牌失败。</p><p><a class=\\\"btn primary\\\" href=\\\"/api/pay/return?order_no=\" + ui.esc(order_no) + \"&amp;token=\" + ui.esc(pptoken) + \"\\\">重试</a> <a class=\\\"btn ghost\\\" href=\\\"/shop\\\">返回商城</a></p></div>\"); }\n"
    + "  let cap = pay.paypal_capture(PAYPAL_CFG, str(get(tk, \"token\", \"\")), pptoken);\n"
    + "  if (get(cap, \"ok\", false) != true) { return ui.page(\"支付失败\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付失败 <span class=\\\"badge\\\">PayPal</span></h1><p>捕获失败：\" + ui.esc(str(get(cap, \"err\", \"\"))) + \"</p><p><a class=\\\"btn primary\\\" href=\\\"/api/pay/return?order_no=\" + ui.esc(order_no) + \"&amp;token=\" + ui.esc(pptoken) + \"\\\">重新捕获</a> <a class=\\\"btn ghost\\\" href=\\\"/shop\\\">返回商城</a></p></div>\"); }\n"
    + "  // 回填 PayPal 侧 ID（paypal_order_id=approve token，capture_id=捕获记录）——退款路由凭 capture_id 退；\n"
    + "  // 422 已捕获对账路径 capture_id 为空，退款时由 shop/refund 的 paypal_get_order 反查兜底。\n"
    + "  sql_write(db.dsn(), \"" + upd_paid_ids + "\", [pptoken, str(get(cap, \"capture_id\", \"\")), order_no]);\n"
    + "  return ui.page(\"支付成功\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付成功 <span class=\\\"badge\\\">PayPal</span></h1><p>订单 <code>\" + ui.esc(order_no) + \"</code> · 金额 <strong>\" + csym + \"\" + pay.fmt_cents(cents) + \"</strong> 已支付。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/refund/\" + ui.esc(order_no) + \"\\\">申请退款</a></p></div>\");\n"
    + "};\n\n"
    // ---- get /api/pay/cancel：用户取消 ----
    + "get \"/api/pay/cancel\", func(req) {\n"
    + "  let order_no = str(get(req.query_params, \"order_no\", \"\"));\n"
    + "  return ui.page(\"支付取消\", \"shop\", \"<div class=\\\"panel\\\"><h1>支付取消 <span class=\\\"badge\\\">PayPal</span></h1><p>订单 <code>\" + ui.esc(order_no) + \"</code> 已取消。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">返回商城</a></p></div>\");\n"
    + "};\n\n"
    // ---- post /api/pay/webhook：可选，简化 HMAC 验签（webhook_path 配置时生成）----
    + (wpath != "" ?
        "post \"" + wpath + "\", func(req) {\n"
      + "  let data = json(req.body);\n"
      + "  if (data == null) { return { \"status\": 400, \"body\": { \"err\": \"invalid json\" } }; }\n"
      + "  let id = str(get(data, \"verify_id\", \"\"));\n"
      + "  let ts = str(get(data, \"verify_ts\", \"\"));\n"
      + "  let sign = str(get(data, \"verify_sign\", \"\"));\n"
      + "  let payload = str(get(data, \"payload\", \"\"));\n"
      + "  if (!pay.paypal_verify_webhook(str(get(PAYPAL_CFG, \"client_secret\", \"\")), id, ts, payload, sign)) {\n"
      + "    return { \"status\": 401, \"body\": { \"err\": \"signature mismatch\" } };\n"
      + "  }\n"
      + "  return { \"status\": 200, \"body\": { \"ok\": true } };\n"
      + "};\n" : "");
  return b;
}

// 生成店面接线块（config.shop 存在且 pay 非 null 时注入 app.lume）：
//   get /shop（商品列表；新库空表一次性播种示例商品，页内带「清空商品」按钮；
//   ?act=clear 清空目录并落标记不再自动复活 / ?act=seed 手动重载示例——并回本路由
//   不占额外路由位：lume-core 解释器路由表上限 32 条，PayPal 变体已逼近）
//   + /shop/buy/:id（下单 pending）
//   + /shop/pay/:ono（收银台：PayPal approve_url，已建单则复用不重建）
//   + /shop/result/:ono（支付结果）
//   + /shop/refund/:ono（退款：确认页 ?confirm=1 执行；仅 paid 可退，重复退幂等）。
// 依赖同一 app.lume 里支付接线块的模块级 PAYPAL_CFG/PAYPAL_RETURN_BASE，
// 故 shop 必须与 pay 同时配置。
// 产物级模板写好后由 replace() 注入配置标识符（均过 validate 白名单），
// 避免逐行手写双层转义（曾在此踩坑：get(p, \"name\") 多一层反斜杠）。
export func gen_shop_block(shop, pay): string {
  // 店面 UI 明示支付渠道与币种：徽标文案 __PN__ 与价格符号 __CUR__（PayPal，$ 计价）
  let pname = "PayPal";
  let pcur = str(get(pay, "currency_symbol", "$"));
  let pm = str(get(shop, "product_module", "product"));
  let nf = str(get(shop, "name_field", "name"));
  let pf = str(get(shop, "price_field", "price_cents"));
  let om = str(get(pay, "order_module", ""));
  let onf = str(get(pay, "order_no_field", "order_no"));
  let amf = str(get(pay, "amount_field", "amount_cents"));
  let stf = str(get(pay, "status_field", "status"));
  // 退款关联列（PayPal 分支用）：捕获回填 paypal_order_id/capture_id，退款凭 capture_id 退
  let ppidf = str(get(pay, "paypal_order_field", "paypal_order_id"));
  let capf = str(get(pay, "capture_id_field", "capture_id"));
  let sel_ref = "SELECT \\\"" + stf + "\\\", \\\"" + amf + "\\\", \\\"" + ppidf + "\\\", \\\"" + capf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ?";
  let upd_refunded = "UPDATE \\\"" + om + "\\\" SET \\\"" + stf + "\\\" = 'refunded' WHERE \\\"" + onf + "\\\" = ?";
  // 收银台建单后立即回填 PayPal 订单 ID（捕获时的 return 处理器也回填，但那是
  // 用户 approve 之后的事——不回填的话刷新一次收银台就多一笔 PayPal 孤儿单）
  let upd_ppid = "UPDATE \\\"" + om + "\\\" SET \\\"" + ppidf + "\\\" = ? WHERE \\\"" + onf + "\\\" = ?";
  // 退款回补关联 ID（早期订单缺列时手动/反查补齐后写回，使后续操作一致）
  let upd_ppid_cap = "UPDATE \\\"" + om + "\\\" SET \\\"" + ppidf + "\\\" = ?, \\\"" + capf + "\\\" = ? WHERE \\\"" + onf + "\\\" = ?";
  // 商品快照/库存（可选，P1-2 收口；三个键均经 validate_shop 校验存在性）：
  //   prdf  订单行商品 id 列——无 ik 购买时复用该商品 pending 单、退款回补库存靠它定位
  //   pnmf  订单行商品名快照列——下单时定格商品名，订单后台直接可见「买了什么」
  //   skf   商品行库存列——buy 守卫扣减（0 行=售罄）、refund 回补；依赖 prdf
  let prdf = str(get(shop, "product_field", ""));
  let pnmf = str(get(shop, "product_name_field", ""));
  let skf = str(get(shop, "stock_field", ""));
  let has_pref = prdf != "";
  let has_stock = skf != "" && prdf != "";
  // 库存扣减/回补/pending 单查询/补偿删单（标识符均过白名单，直拼进生成的 SQL）
  let dec_stock = "UPDATE \\\"" + pm + "\\\" SET \\\"" + skf + "\\\" = \\\"" + skf + "\\\" - 1 WHERE \\\"id\\\" = ? AND \\\"" + skf + "\\\" >= 1";
  let inc_stock = "UPDATE \\\"" + pm + "\\\" SET \\\"" + skf + "\\\" = \\\"" + skf + "\\\" + 1 WHERE \\\"id\\\" = ?";
  // 手动退款（已在 PayPal 后台退）本地标记时回补库存的分支尾（has_stock 才有）
  let refund_manual_tail = "";
  if (has_stock) {
    refund_manual_tail = ""
      + "    let rpid_s = str(get(o, \"" + prdf + "\", \"\"));\n"
      + "    if (rpid_s == \"null\" || rpid_s == \"\") { rpid_s = \"0\"; }\n"
      + "    if (int(rpid_s) > 0) { sql_write(db.dsn(), \"" + inc_stock + "\", [int(rpid_s)]); }\n";
  }
  let sel_pending = "SELECT \\\"" + onf + "\\\" FROM \\\"" + om + "\\\" WHERE \\\"" + prdf + "\\\" = ? AND \\\"" + stf + "\\\" = 'pending' ORDER BY \\\"id\\\" DESC LIMIT 1";
  let del_pending = "DELETE FROM \\\"" + om + "\\\" WHERE \\\"" + onf + "\\\" = ? AND \\\"" + stf + "\\\" = 'pending'";
  // 订单 INSERT 的列与值（商品快照列可选加入；status 恒 'pending'）
  let ocols = "\\\"" + onf + "\\\", \\\"" + amf + "\\\"";
  let ovals = "?, ?";
  if (has_pref) { ocols = ocols + ", \\\"" + prdf + "\\\""; ovals = ovals + ", ?"; }
  if (pnmf != "") { ocols = ocols + ", \\\"" + pnmf + "\\\""; ovals = ovals + ", ?"; }
  ocols = ocols + ", \\\"" + stf + "\\\"";
  ovals = ovals + ", 'pending'";
