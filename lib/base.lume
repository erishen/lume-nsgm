    + "  // 退款请求带入手动恢复的关联 ID（PayPal 订单号 / 捕获 ID）\n"
    + "  let ppid = str(get(o, \"" + ppidf + "\", \"\"));\n"
    + "  if (ppid == \"null\") { ppid = \"\"; }\n"
    + "  let cap_id = str(get(o, \"" + capf + "\", \"\"));\n"
    + "  if (cap_id == \"null\") { cap_id = \"\"; }\n"
    + "  if (ppid == \"\" && q_ppid != \"\") { ppid = q_ppid; }\n"
    + "  if (cap_id == \"\" && q_capid != \"\") { cap_id = q_capid; }\n"
    + "  let need_recover = (cap_id == \"\" && ppid == \"\");\n"
    + "  if (confirm != \"1\") {\n"
    + "    if (need_recover) {\n"
    + "      let body = \"<div class=\\\"panel\\\"><h1>申请退款 <span class=\\\"badge\\\">__PN__</span></h1>\\n<p>订单 <code>\" + ui.esc(ono) + \"</code> 金额 <strong>__CUR__\" + pay.fmt_cents(cents) + \"</strong></p>\\n<div class=\\\"flash warn\\\">该订单缺少 PayPal 关联 ID（早期订单），无法自动定位捕获记录。</div>\\n<p><a class=\\\"btn primary\\\" href=\\\"/shop/recover/\" + ui.esc(ono) + \"\\\">去恢复关联 ID 并退款</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/result/\" + ui.esc(ono) + \"\\\">返回</a></p></div>\\n\";\n"
    + "      return ui.page(\"申请退款\", \"shop\", body);\n"
    + "    }\n"
    + "    let body = \"<div class=\\\"panel\\\"><h1>申请退款 <span class=\\\"badge\\\">__PN__</span></h1>\\n<p>订单 <code>\" + ui.esc(ono) + \"</code> · 金额 <strong>__CUR__\" + pay.fmt_cents(cents) + \"</strong> · 状态 \" + ui.esc(st) + \"</p>\\n\"\n"
    + "      + \"<p class=\\\"muted\\\">退款将原路退回原支付账户。</p>\\n\"\n"
    + "      + \"<p><a class=\\\"btn primary\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1\\\">确认退款</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/result/\" + ui.esc(ono) + \"\\\">返回</a></p></div>\\n\";\n"
    + "    return ui.page(\"申请退款\", \"shop\", body);\n"
    + "  }\n"
    + "  if (st == \"refunded\") {\n"
    + "    return ui.page(\"已退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>已退款 <span class=\\\"badge\\\">__PN__</span></h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 已是退款状态。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a></p></div>\");\n"
    + "  }\n"
    + "  if (st != \"paid\") {\n"
    + "    return ui.page(\"退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">仅已支付订单可退款（当前状态：\" + ui.esc(st) + \"）</div><p><a href=\\\"/shop/result/\" + ui.esc(ono) + \"\\\">查看订单</a></p></div>\");\n"
    + "  }\n"
    ;
    t = t + ""
    + "  // 已在 PayPal 后台手动退款：仅本地标记退款（状态 + 库存闭环），不调 PayPal API\n"
    + "  if (manual == \"1\") {\n"
    + "    sql_write(db.dsn(), \"" + upd_refunded + "\", [ono]);\n"
    + refund_manual_tail
    + "    return ui.page(\"已退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>已退款 <span class=\\\"badge\\\">__PN__</span></h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 已在 PayPal 后台手动退款，本地状态已标记。</p><p class=\\\"muted\\\">如尚未在 PayPal 退款，请先到后台操作。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a></p></div>\");\n"
    + "  }\n"
    + "  // 捕获 ID 定位：本地 cap_id -> 本地/请求 ppid 反查 -> 请求 capid 直达\n"
    + "  // ppid 反查带捕获兜底：用户常把 PayPal 后台的「交易号/Transaction ID」（即捕获\n"
    + "  // ID）当订单号填入——订单 GET 对捕获 ID 回 404 RESOURCE_NOT_FOUND。此时改查\n"
    + "  // 捕获接口（related_ids.order_id 反解真实订单号），两列均回填正确值；已在真实\n"
    + "  // 沙箱验证：捕获 ID 走 orders 端点必 404，走 captures 端点 200。\n"
    + "  if (cap_id == \"\" && ppid != \"\") {\n"
    + "    let tk0 = pay.paypal_token(PAYPAL_CFG);\n"
    + "    if (get(tk0, \"ok\", false) != true) { return ui.page(\"退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">PayPal 令牌失败：\" + ui.esc(str(get(tk0, \"err\", \"\"))) + \"</div><p><a class=\\\"btn primary\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1&ppid=\" + ui.esc(ppid) + \"\\\">重试</a></p></div>\"); }\n"
    + "    let tok0 = str(get(tk0, \"token\", \"\"));\n"
    + "    let go = pay.paypal_get_order(PAYPAL_CFG, tok0, ppid);\n"
    + "    if (get(go, \"ok\", false) != true) {\n"
    + "      let gc = pay.paypal_get_capture(PAYPAL_CFG, tok0, ppid);\n"
    + "      if (get(gc, \"ok\", false) == true) {\n"
    + "        cap_id = str(get(gc, \"capture_id\", \"\"));\n"
    + "        let rppid = str(get(gc, \"order_id\", \"\"));\n"
    + "        if (rppid != \"\") { ppid = rppid; }\n"
    + "      }\n"
    + "    } else {\n"
    + "      cap_id = str(get(go, \"capture_id\", \"\"));\n"
    + "    }\n"
    + "    if (cap_id == \"\") { return ui.page(\"退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">无法从 PayPal 反查捕获记录：\" + ui.esc(str(get(go, \"err\", \"\"))) + \"</div><p class=\\\"muted\\\">可能原因：① 填写的 ID 有误或复制了其他交易；② 本店运行在 PayPal 沙箱（sandbox），而该 ID 来自正式（live）账号——请到 sandbox.paypal.com 后台重新查找；③ 这笔单并未通过 PayPal 收款。错误信息里的 debug_id 可提供给 PayPal 支持定位。</p><p class=\\\"muted\\\">若确认已在 PayPal 后台手动退款，可直接本地标记。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop/recover/\" + ui.esc(ono) + \"\\\">去恢复关联 ID</a> <a class=\\\"btn ghost\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1&manual=1\\\">本地标记退款</a></p></div>\"); }\n"
    + "  }\n"
    + "  if (cap_id == \"\") { return ui.page(\"退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">仍未定位到捕获记录：请填入 PayPal 订单号/捕获 ID，或确认已在后台手动退款。</div><p><a class=\\\"btn primary\\\" href=\\\"/shop/recover/\" + ui.esc(ono) + \"\\\">去恢复关联 ID</a></p></div>\"); }\n"
    + "  let tk = pay.paypal_token(PAYPAL_CFG);\n"
    + "  if (get(tk, \"ok\", false) != true) { return ui.page(\"退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">PayPal 令牌失败：\" + ui.esc(str(get(tk, \"err\", \"\"))) + \"</div><p><a class=\\\"btn primary\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1\" + (ppid != \"\" ? \"&ppid=\" + ui.esc(ppid) : \"\") + (q_capid != \"\" ? \"&capid=\" + ui.esc(q_capid) : \"\") + \"\\\">重试</a></p></div>\"); }\n"
    + "  let rf = pay.paypal_refund(PAYPAL_CFG, str(get(tk, \"token\", \"\")), cap_id, cents, \"Refund \" + ono);\n"
    + "  if (get(rf, \"ok\", false) != true) { return ui.page(\"退款失败\", \"shop\", \"<div class=\\\"panel\\\"><h1>退款失败 <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">退款失败：\" + ui.esc(str(get(rf, \"err\", \"\"))) + \"</div><p><a class=\\\"btn primary\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1\" + (ppid != \"\" ? \"&ppid=\" + ui.esc(ppid) : \"\") + (q_capid != \"\" ? \"&capid=\" + ui.esc(q_capid) : \"\") + \"\\\">重试</a></p></div>\"); }\n"
    + "  // 回补关联 ID（本次靠手动/反查补齐，使后续操作一致）；原行缺失才写回\n"
    + "  if (ppid != \"\" || cap_id != \"\") { sql_write(db.dsn(), \"" + upd_ppid_cap + "\", [ppid, cap_id, ono]); }\n"
      ;
  if (has_stock) {
    t = t + ""
      + "  // 退款回补库存（P1-2）：凭订单行商品 id 列定位商品行；早期订单无商品引用则跳过\n"
      + "  let rpid_s = str(get(o, \"" + prdf + "\", \"\"));\n"
      + "  if (rpid_s == \"null\" || rpid_s == \"\") { rpid_s = \"0\"; }\n"
      + "  if (int(rpid_s) > 0) { sql_write(db.dsn(), \"" + inc_stock + "\", [int(rpid_s)]); }\n";
  }
  t = t + ""
    + "  sql_write(db.dsn(), \"" + upd_refunded + "\", [ono]);\n"
    + "  return ui.page(\"已退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>已退款 <span class=\\\"badge\\\">__PN__</span></h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 已退款 <strong>__CUR__\" + pay.fmt_cents(cents) + \"</strong>。</p><p class=\\\"muted\\\">款项将原路退回原支付账户。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a></p></div>\");\n"
    + "};\n"
    ;
  // 恢复路由：早期订单缺 PayPal 关联 ID（迁移补列前，paypal_order_id/capture_id 全 NULL）
  // 时，手工填入 PayPal 订单号（反查捕获记录；订单号框亦接受交易号/捕获 ID，订单 GET
  // 404 后自动改查捕获接口反解订单号）或直接填捕获 ID（直达退款），或标记后台已退。
  t = t + ""
    + "get \"/shop/recover/:ono\", func(req) {\n"
    + "  let ono = str(get(req.params, \"ono\", \"\"));\n"
    + "  let orows = sql_query(db.dsn(), \"SELECT * FROM \\\"__OM__\\\" WHERE \\\"__ONF__\\\" = ?\", [ono]);\n"
    + "  if (len(orows) == 0) { return ui.page(\"恢复关联 ID\", \"shop\", \"<div class=\\\"panel\\\"><h1>恢复关联 ID <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">订单不存在</div><p><a href=\\\"/shop\\\">返回商城</a></p></div>\"); }\n"
    + "  let o = orows[0];\n"
    + "  let cents = int(get(o, \"__AMF__\", 0));\n"
    + "  let st = str(get(o, \"__STF__\", \"\"));\n"
    + "  if (st == \"refunded\") { return ui.page(\"已退款\", \"shop\", \"<div class=\\\"panel\\\"><h1>已退款 <span class=\\\"badge\\\">__PN__</span></h1><p>订单 <code>\" + ui.esc(ono) + \"</code> 已退款。</p><p><a class=\\\"btn primary\\\" href=\\\"/shop\\\">继续购物</a></p></div>\"); }\n"
    + "  if (st != \"paid\") { return ui.page(\"恢复关联 ID\", \"shop\", \"<div class=\\\"panel\\\"><h1>恢复关联 ID <span class=\\\"badge\\\">__PN__</span></h1><div class=\\\"flash err\\\">仅已支付订单可恢复关联 ID（当前状态：\" + ui.esc(st) + \"）</div><p><a href=\\\"/shop/result/\" + ui.esc(ono) + \"\\\">查看订单</a></p></div>\"); }\n"
    + "  let ppid = str(get(o, \"" + ppidf + "\", \"\"));\n"
    + "  if (ppid == \"null\") { ppid = \"\"; }\n"
    + "  let cap_id = str(get(o, \"" + capf + "\", \"\"));\n"
    + "  if (cap_id == \"null\") { cap_id = \"\"; }\n"
    + "  let body = \"<div class=\\\"panel\\\"><h1>恢复 PayPal 关联 ID <span class=\\\"badge\\\">__PN__</span></h1>\\n\"\n"
    + "    + \"<p>订单 <code>\" + ui.esc(ono) + \"</code> 金额 <strong>__CUR__\" + pay.fmt_cents(cents) + \"</strong></p>\\n\"\n"
    + "    + \"<div class=\\\"flash warn\\\">该订单缺少 PayPal 关联 ID（早期订单），无法自动定位捕获记录。请在 PayPal 后台查到后填入，或确认已手动退款。</div>\\n\"\n"
    + "    + \"<h2>方式一：填入 PayPal 订单号或交易号</h2>\\n\"\n"
    + "    + \"<p class=\\\"muted\\\">本店运行在 <strong>PayPal 沙箱</strong>：请登录 <code>sandbox.paypal.com</code> → Activity 找到这笔交易 → 打开详情页。</p>\\n\"\n"
    + "    + \"<p class=\\\"muted\\\"><strong>订单号</strong>（Order ID，17 位，如 <code>1AB23456CD7890123</code>）或 <strong>交易号</strong>（Transaction ID，即捕获 ID，如 <code>2CD34567DE8901234</code>）——任意填一个即可，系统会自动识别，只找到交易号也没问题。</p>\\n\"\n"
    + "    + \"<form method=\\\"get\\\" action=\\\"/shop/refund/\" + ui.esc(ono) + \"\\\">\\n\"\n"
    + "    + \"<input type=\\\"hidden\\\" name=\\\"confirm\\\" value=\\\"1\\\">\\n\"\n"
    + "    + \"<label>PayPal 订单号或交易号 <input type=\\\"text\\\" name=\\\"ppid\\\" placeholder=\\\"1AB… 或 2CD…，二选一\\\"></label><br>\\n\"\n"
    + "    + \"<button class=\\\"btn primary\\\" type=\\\"submit\\\">查询并退款</button></form>\\n\"\n"
    + "    + \"<h2>方式二：直接填捕获 ID</h2>\\n\"\n"
    + "    + \"<p class=\\\"muted\\\">已单独复制到交易号（捕获 ID）的话，也可直接填这里，跳过反查：</p>\\n\"\n"
    + "    + \"<form method=\\\"get\\\" action=\\\"/shop/refund/\" + ui.esc(ono) + \"\\\">\\n\"\n"
    + "    + \"<input type=\\\"hidden\\\" name=\\\"confirm\\\" value=\\\"1\\\">\\n\"\n"
    + "    + \"<label>捕获 ID <input type=\\\"text\\\" name=\\\"capid\\\" placeholder=\\\"直接退款\\\"></label>\\n\"\n"
    + "    + \"<button class=\\\"btn ghost\\\" type=\\\"submit\\\">直接退款</button></form>\\n\"\n"
    + "    + \"<h2>方式三：已在 PayPal 后台手动退款</h2>\\n\"\n"
    + "    + \"<p class=\\\"muted\\\">这笔款已在 PayPal 后台退过（或并非通过 PayPal 收款）？直接本地标记，不调用 PayPal：</p>\\n\"\n"
    + "    + \"<p><a class=\\\"btn ghost\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"?confirm=1&manual=1\\\">本地标记退款</a></p>\\n\"\n"
    + "    + \"<p><a class=\\\"btn ghost\\\" href=\\\"/shop/refund/\" + ui.esc(ono) + \"\\\">返回退款页</a></p></div>\\n\";\n"
    + "  return ui.page(\"恢复关联 ID\", \"shop\", body);\n"
    + "};\n"
    ;
  // 占位符统一在拼接完成后替换（分支/尾部模板同样带占位符）
  t = replace(t, "__PM__", pm);
  t = replace(t, "__NF__", nf);
  t = replace(t, "__PF__", pf);
  t = replace(t, "__OM__", om);
  t = replace(t, "__ONF__", onf);
  t = replace(t, "__AMF__", amf);
  t = replace(t, "__STF__", stf);
  t = replace(t, "__PN__", pname);
  t = replace(t, "__CUR__", pcur);
  t = replace(t, "__SKF__", skf);
  return t;
}

// 生成 app.lume 入口：server 块 + 模块装配（import 即注册路由）+ 建表 + run()
// 顺序对照 lume 仓 examples/demo.lume：server{} -> routes(经 import) -> run()
// pay 为 config.pay（validate_pay 已过）或 null；非 null 时注入支付接线块。
export func gen_app_entry(out: string, mods, pay, shop): int {
  let imports = "";
  let ddl_args = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      imports = imports + "import \"modules/" + name + ".lume\" as " + name + ";\n";
      if (ddl_args != "") { ddl_args = ddl_args + ", "; }
      ddl_args = ddl_args + "{ \"name\": " + name + ".TBL, \"ddl\": " + name + ".DDL, \"cols\": " + name + ".COLS }";
    }
    i = i + 1;
  }
  if (pay != null) {
    imports = imports + "import \"lib/pay.lume\" as pay;\n";
  }
  let content = "// app.lume — lume-nsgm 生成入口（勿手改）\n"
    + "// 运行：lume-core app.lume  （lume-core 0.7.0+ 自带 server/route/run、sql 内建与 docroot 静态）\n"
    + "// 端口/host/workers 从环境变量读取（PORT/HOST/WORKERS），未设置时用下方默认值。\n"
    + "// 注：env() 在 server{} 中生效需默认（解释器）后端；Docker 构建已强制 HAVE_LLVM=0。\n"
    + "server {\n"
    + "  port = (env(\"PORT\") != null && env(\"PORT\") != \"\") ? int(env(\"PORT\")) : 8081;\n"
    + "  host = (env(\"HOST\") != null && env(\"HOST\") != \"\") ? env(\"HOST\") : \"127.0.0.1\";\n"
    + "  workers = (env(\"WORKERS\") != null && env(\"WORKERS\") != \"\") ? int(env(\"WORKERS\")) : 4;\n"
    + "  docroot = \"./www\";\n}\n\n"
    + "import \"lib/ui.lume\" as ui;\n"
    + "import \"lib/db.lume\" as db;\n"
    + imports
    + "\n// 首次启动自动建表（CREATE TABLE IF NOT EXISTS），并对已有表补齐新增列（迁移）\n"
    + "db.init([" + ddl_args + "]);\n\n"
    + (pay != null ? gen_paypal_block(pay) + "\n" : "")
    + (pay != null && shop != null ? gen_shop_block(shop, pay) + "\n" : "")
    + "// 首页导航\n"
    + "get \"/\", func(req) {\n"
    + "  let body = \"<h1>lume-nsgm 生成的项目</h1>\\n<ul>\\n\";\n";
  i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      content = content + "  body = body + \"  <li><a href=/" + name + ">" + name + "</a></li>\\n\";\n";
    }
    i = i + 1;
  }
  content = content + (pay != null && shop != null ? "  body = body + \"  <li><a href=/shop>商城（店面演示）</a></li>\\n\";\n" : "")
    + "  body = body + \"</ul>\\n\";\n"
    + "  return ui.page(\"首页\", \"\", body);\n"
    + "};\n\n"
    + "run();\n";
  write_file(out + "/app.lume", content);
  return 0;
}

// 串联：建目录 -> 复制静态基座 -> ui.lume -> app.lume -> web/ React 前端
// pay 为 config.pay（或 null）；非 null 时 app.lume 注入支付接线（见 gen_paypal_block）
// shop 为 config.shop（或 null）；pay+shop 同时非 null 时注入店面（见 gen_shop_block）
export func base_project(out: string, mods, pay, shop): int {
  mkdir(out);
  mkdir(out + "/lib");
  mkdir(out + "/modules");
  mkdir(out + "/sql");
  mkdir(out + "/www");
  mkdir(out + "/data");

  copy_base(out);
  gen_ui(out, mods, shop);
  gen_app_entry(out, mods, pay, shop);
  rg.gen_web(out, mods);
  return 0;
}
