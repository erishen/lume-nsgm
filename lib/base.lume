// base.lume — 输出以 lume 为底的可运行工程（app.lume + lib + modules + www + web）
// 与 lib/scaffold.lume 的 write_tree 配合：write_tree 写 modules/<ctrl>.lume
// 与 sql/<ctrl>.sql，本文件负责复制静态基座、生成 lib/ui.lume（NAV 注入）、
// app.lume 入口与 web/ React 前端（Vite + React + TS，经 lib/reactgen.lume）。
import "model.lume" as m;
import "reactgen.lume" as rg;

// 需要从 scaffold/ 复制的静态文件（路径相对于生成根 out）
let STATIC_FILES = [
  "lib/db.lume",
  "www/app.css",
  "www/app.js",
  "README.run.md"
];

// 复制静态基座文件（scaffold/ -> out/）
export func copy_base(out: string): int {
  let i = 0;
  while (i < len(STATIC_FILES)) {
    let f = STATIC_FILES[i];
    let content = read_file("scaffold/" + f);
    if (content != null) {
      write_file(out + "/" + f, content);
    } else {
      print("WARN: scaffold/" + f + " missing");
    }
    i = i + 1;
  }
  return 0;
}

// 生成 lib/ui.lume：SSR 组件库，NAV 由模块清单注入
export func gen_ui(out: string, mods): int {
  let nav_rows = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      let label = get(mod, "label", name);
      nav_rows = nav_rows + "  [\"" + name + "\", \"" + label + "\"],\n";
    }
    i = i + 1;
  }
  let content = "// lib/ui.lume — SSR 组件库（lume-nsgm 生成：NAV 为模块清单）\n"
    + "let NAV = [\n" + nav_rows + "];\n\n"
    + "export func esc(s): string {\n"
    + "  let out = str(s);\n"
    + "  out = replace(out, \"&\", \"&amp;\");\n"
    + "  out = replace(out, \"<\", \"&lt;\");\n"
    + "  out = replace(out, \">\", \"&gt;\");\n"
    + "  out = replace(out, \"\\\"\", \"&quot;\");\n"
    + "  return out;\n"
    + "}\n\n"
    + "export func nav(active: string): string {\n"
    + "  let out = \"<header class=\\\"nav\\\"><a class=\\\"brand\\\" href=\\\"/\\\">lume-nsgm</a>\";\n"
    + "  let i = 0;\n"
    + "  while (i < len(NAV)) {\n"
    + "    let item = NAV[i];\n"
    + "    let cls = \"\";\n"
    + "    if (item[0] == active) { cls = \" class=\\\"active\\\"\"; }\n"
    + "    out = out + \"<a\" + cls + \" href=/\" + item[0] + \">\" + esc(item[1]) + \"</a>\";\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return out + \"</header>\";\n"
    + "}\n\n"
    + "export func page(title: string, active: string, body: string): string {\n"
    + "  return \"<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n\"\n"
    + "    + \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"\n"
    + "    + \"<title>\" + esc(title) + \"</title>\\n\"\n"
    + "    + \"<link rel=\\\"stylesheet\\\" href=\\\"/app.css\\\">\\n\"\n"
    + "    + \"<script src=\\\"/app.js\\\" defer></script>\\n</head>\\n<body>\\n\"\n"
    + "    + nav(active)\n"
    + "    + \"<main class=\\\"container\\\">\\n\" + body + \"</main>\\n</body>\\n</html>\\n\";\n"
    + "}\n";
  write_file(out + "/lib/ui.lume", content);
  return 0;
}

// 生成 app.lume 入口：server 块 + 模块装配（import 即注册路由）+ 建表 + run()
// 顺序对照 lume 仓 examples/demo.lume：server{} -> routes(经 import) -> run()
export func gen_app_entry(out: string, mods): int {
  let imports = "";
  let ddl_args = "";
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      imports = imports + "import \"modules/" + name + ".lume\" as " + name + ";\n";
      if (ddl_args != "") { ddl_args = ddl_args + ", "; }
      ddl_args = ddl_args + name + ".DDL";
    }
    i = i + 1;
  }
  let content = "// app.lume — lume-nsgm 生成入口（勿手改）\n"
    + "// 运行：lume app.lume  （需要 lume 宿主：server/route/run 与 sql 内建）\n"
    + "server {\n  port = 8081;\n  workers = 4;\n  docroot = \"./www\";\n}\n\n"
    + "import \"lib/ui.lume\" as ui;\n"
    + "import \"lib/db.lume\" as db;\n"
    + imports
    + "\n// 首次启动自动建表（CREATE TABLE IF NOT EXISTS 幂等）\n"
    + "db.init([" + ddl_args + "]);\n\n"
    + "// 首页导航\n"
    + "get \"/\", func(req) {\n"
    + "  let body = \"<h1>lume-nsgm 生成的项目</h1>\\n<ul>\\n\";\n";
  i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let name = get(mod, "name", "");
    if (name != "") {
      content = content + "  body = body + \"  <li><a href=/" + name + ">" + name + "</a></li>\\n\";\n";
    }
    i = i + 1;
  }
  content = content + "  body = body + \"</ul>\\n\";\n"
    + "  return ui.page(\"首页\", \"\", body);\n"
    + "};\n\n"
    + "run();\n";
  write_file(out + "/app.lume", content);
  return 0;
}

// 串联：建目录 -> 复制静态基座 -> ui.lume -> app.lume -> web/ React 前端
export func base_project(out: string, mods): int {
  mkdir(out);
  mkdir(out + "/lib");
  mkdir(out + "/modules");
  mkdir(out + "/sql");
  mkdir(out + "/www");
  mkdir(out + "/data");

  copy_base(out);
  gen_ui(out, mods);
  gen_app_entry(out, mods);
  rg.gen_web(out, mods);
  return 0;
}
