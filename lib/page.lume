// page.lume — 页面生成器（模板渲染版，Antd Table + 搜索框 + 简单 Modal 表单）
// 对照 nsgm src/generators/page-generator.ts；M1 精简：不含上传/CSV/i18n 完整集成
import "model.lume" as m;
import "tpl.lume" as tpl;

export func gen_page(ctrl: string, fs, n: int): string {
  let C = m.cap(ctrl);
  let list = m.list_idx(fs, n);
  let form = m.form_idx(fs, n);
  let search = m.search_idx(fs, n);
  let cols = columns(fs, list);
  let modal = modal_fields(fs, form);
  let main_s = main_search(fs, search);
  let search_hook = "";
  if (main_s != "") { search_hook = "  const [search" + m.cap(main_s) + ", setSearch" + m.cap(main_s) + "] = useState('')\n"; }
  let ctx = {
    "ctrl": ctrl, "C": C,
    "cols": cols, "modal": modal,
    "search_hook": search_hook,
    "search_input": search_input(main_s),
    "search_arg": search_arg(fs, search, main_s)
  };
  let tpl_text = read_file("templates/page.tpl");
  if (tpl_text == null) { return "// ERROR: templates/page.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 表格列
func columns(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let f = fs[idx[i]];
    push(out, "  { title: '" + m.cap(m.fname(f)) + "', dataIndex: '" + m.fname(f) + "' },\n");
    i = i + 1;
  }
  return join(out, "");
}

// Modal 表单字段
func modal_fields(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let f = fs[idx[i]];
    let nm = m.fname(f);
    let ph = m.fcomment(f);
    if (ph == "") { ph = nm; }
    push(out, "          <ModalInput\n");
    push(out, "            placeholder=\"" + ph + "\"\n");
    push(out, "            value={values." + nm + "}\n");
    push(out, "            onChange={(e: any) => setValues({ ...values, " + nm + ": e.target.value })}\n");
    push(out, "          />\n");
    i = i + 1;
  }
  return join(out, "");
}

// 主搜索字段（第一个可搜索字段）
func main_search(fs, idx) {
  if (len(idx) == 0) { return ""; }
  return m.fname(fs[idx[0]]);
}

// 搜索参数对象（合法表达式：主搜索字段 -> 对应的 search 状态，其余 -> ''）
func search_arg(fs, idx, main_s) {
  if (len(idx) == 0) { return ""; }
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let nm = m.fname(fs[idx[i]]);
    let expr = "'" + nm + "': ''";
    if (nm == main_s) { expr = "'" + nm + "': search" + m.cap(nm); }
    push(out, expr);
    i = i + 1;
  }
  return join(out, ", ");
}

// 搜索输入框（仅主搜索字段）
func search_input(nm) {
  if (nm == "") { return ""; }
  return "          <StyledInput\n            placeholder=\"搜索" + nm + "\"\n            value={search" + m.cap(nm) + "}\n            onChange={(e: any) => setSearch" + m.cap(nm) + "(e.target.value)}\n          />\n";
}
