// sql.lume — SQL 生成器（模板渲染版，对照 nsgm src/generators/sql-generator.ts）
import "model.lume" as m;
import "tpl.lume" as tpl;

// 字段 -> 模板 ctx 条目：type_sql 等逻辑仍由 model 层计算
func field_ctx(f, last: int) {
  let sd = m.sql_default(f);
  let nn = m.sql_not_null(f) != "";
  // 单列默认子句：sql_default 已编码优先级（create_date/update_date 时间戳、
  // 非必填 varchar -> ''），其余可空字段补显式 DEFAULT NULL。
  // 用互斥逻辑避免原版那种 "DEFAULT NULL DEFAULT ''" 重复默认子句的非法 SQL。
  let dc = sd;
  if (dc == "" && !nn) { dc = " DEFAULT NULL"; }
  // SQLite 主键行（INTEGER PRIMARY KEY AUTOINCREMENT）自带 NOT NULL 语义，
  // 不再渲染冗余的 NOT NULL 子句。
  let shown_nn = nn && m.fauto(f) != 1;
  let fm = {
    "name": m.fname(f),
    "type_sql": m.sql_type(f),
    "not_null": shown_nn,
    "auto": m.fauto(f) == 1,
    "comment": m.fcomment(f),
    "default": dc
  };
  return fm;
}

export func gen_sql(ctrl: string, fs, n: int, db: string): string {
  let fields = [];
  let i = 0;
  while (i < n) {
    push(fields, field_ctx(fs[i], i));
    i = i + 1;
  }
  let ctx = { "db": db, "ctrl": ctrl, "fields": fields };
  let tpl_text = read_file("templates/sql.tpl");
  if (tpl_text == null) { return "// ERROR: templates/sql.tpl missing"; }
  let text = tpl.render(tpl_text, ctx);
  // SQLite 不允许列定义尾随逗号（MySQL 版靠表级 PRIMARY KEY 行兜底）；
  // 模板逐行渲染天然带尾逗号，这里统一去掉最后一处 ",\n)"。
  text = replace(text, ",\n);", "\n);");
  // DDL 会内嵌进模块文件的 lume 字符串字面量，压成单行
  text = replace(text, "\n", " ");
  return text;
}
