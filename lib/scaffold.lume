// scaffold.lume — 文件树写入 + redux/styled/i18n 生成（模板渲染版）
// 对照 nsgm src/generators/file-generator.ts；M1 精简文件集
import "model.lume" as m;
import "tpl.lume" as tpl;

// ---- redux actions ----
export func gen_actions(ctrl: string): string {
  let C = m.cap(ctrl);
  let tpl_text = read_file("templates/actions.tpl");
  if (tpl_text == null) { return "// ERROR: templates/actions.tpl missing"; }
  return tpl.render(tpl_text, { "ctrl": ctrl, "C": C });
}

// ---- redux reducer（含异步 thunk 简版）----
export func gen_reducer(ctrl: string): string {
  let C = m.cap(ctrl);
  let tpl_text = read_file("templates/reducer.tpl");
  if (tpl_text == null) { return "// ERROR: templates/reducer.tpl missing"; }
  return tpl.render(tpl_text, { "ctrl": ctrl, "C": C });
}

// ---- styled-components ----
export func gen_styled(ctrl: string): string {
  let tpl_text = read_file("templates/styled.tpl");
  if (tpl_text == null) { return "// ERROR: templates/styled.tpl missing"; }
  return tpl.render(tpl_text, {});
}

// ---- i18n（zh-CN 简版）----
export func gen_i18n(ctrl: string, fs, n: int): string {
  let C = m.cap(ctrl);
  let tpl_text = read_file("templates/i18n.tpl");
  if (tpl_text == null) { return "// ERROR: templates/i18n.tpl missing"; }
  return tpl.render(tpl_text, { "ctrl": ctrl, "C": C });
}

// ---- 文件树写入 ----
export func write_tree(out: string, ctrl: string, sql_text: string, schema_text: string,
  resolver_text: string, service_text: string, page_text: string,
  actions_text: string, reducer_text: string, styled_text: string, i18n_text: string): int {
  mkdir(out + "/sql");
  mkdir(out + "/schema");
  mkdir(out + "/resolver");
  mkdir(out + "/service");
  mkdir(out + "/page/" + ctrl);
  mkdir(out + "/redux/" + ctrl);
  mkdir(out + "/styled");
  mkdir(out + "/i18n/zh-CN");

  write_file(out + "/sql/" + ctrl + ".sql", sql_text);
  write_file(out + "/schema/" + ctrl + ".ts", schema_text);
  write_file(out + "/resolver/" + ctrl + ".js", resolver_text);
  write_file(out + "/service/" + ctrl + ".ts", service_text);
  write_file(out + "/page/" + ctrl + "/index.tsx", page_text);
  write_file(out + "/redux/" + ctrl + "/actions.ts", actions_text);
  write_file(out + "/redux/" + ctrl + "/reducer.ts", reducer_text);
  write_file(out + "/styled/" + ctrl + ".ts", styled_text);
  write_file(out + "/i18n/zh-CN/" + ctrl + ".ts", i18n_text);
  return 0;
}
