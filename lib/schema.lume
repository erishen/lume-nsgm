// schema.lume — GraphQL schema 生成器（模板渲染版）
// 对照 nsgm src/generators/schema-generator.ts
import "model.lume" as m;
import "tpl.lume" as tpl;

export func gen_schema(ctrl: string, fs, n: int): string {
  let C = m.cap(ctrl);
  let P = C + "s";
  // 类型块必须含主键 id（id 被标 system 而排除在 field_lines 之外，否则
  // GraphQL 不返回 id，前端编辑/删除拿不到 id）。约定主键为整型。
  let type_fields = "            id: Int\n" + join(field_lines(fs, n), "\n");
  let input_fields = join(field_lines_idx(fs, m.form_idx(fs, n)), "\n");
  let search_fields = search_lines(fs, n);
  let ctx = {
    "ctrl": ctrl, "C": C, "P": P,
    "type_fields": type_fields, "input_fields": input_fields,
    "search_fields": search_fields
  };
  let tpl_text = read_file("templates/schema.tpl");
  if (tpl_text == null) { return "// ERROR: templates/schema.tpl missing"; }
  return tpl.render(tpl_text, ctx);
}

// 非系统字段的 schema 行（缩进对齐 nsgm 模板的 12 空格）
func field_lines(fs, n: int) {
  let idx = m.non_system_idx(fs, n);
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let f = fs[idx[i]];
    push(out, "            " + m.fname(f) + ": " + m.gql_type(m.ftype(f)));
    i = i + 1;
  }
  return out;
}

// 指定下标集合的 schema 行（form 字段）
func field_lines_idx(fs, idx) {
  let out = [];
  let i = 0;
  let k = len(idx);
  while (i < k) {
    let f = fs[idx[i]];
    push(out, "            " + m.fname(f) + ": " + m.gql_type(m.ftype(f)));
    i = i + 1;
  }
  return out;
}

// 搜索字段行（无搜索字段时回退 name: String）
func search_lines(fs, n: int): string {
  let idx = m.search_idx(fs, n);
  if (len(idx) == 0) { return "            name: String"; }
  return join(field_lines_idx(fs, idx), "\n");
}
