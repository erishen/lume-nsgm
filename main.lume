// main.lume — lume-nsgm CLI 入口
// 用法：
//   lume-core main.lume create <module> [db] [out]   — 命令行单模块生成
//   lume-core main.lume init <module> [db] [out]     — 交互式字段录入后生成（stdin）
//   lume-core main.lume example-config.json          — 读配置文件批量生成
// 产物为以 lume 为底的可运行工程（app.lume + modules + lib + www + web React 前端），
// 用 lume 宿主运行服务端，web/ 用 pnpm dev 联调。
import "lib/model.lume" as m;
import "lib/sql.lume" as sql;
import "lib/modlume.lume" as modlume;
import "lib/scaffold.lume" as sc;
import "lib/base.lume" as base;

func gen_one(ctrl: string, fs, n: int, db: string, out: string): int {
  let sql_text = sql.gen_sql(ctrl, fs, n, db);
  let module_text = modlume.gen_module(ctrl, fs, n);
  sc.write_tree(out, ctrl, sql_text, module_text);
  print("generated: " + ctrl + " -> " + out);
  return 0;
}

// 命令行 create：位置参数 ctrl，可选 db/out
func cmd_create(args): int {
  let ctrl = get(args, 1, "");
  if (ctrl == "") {
    print("usage: lume-core main.lume create <module> [db] [out]");
    return 1;
  }
  let db = get(args, 2, "crm_demo");
  let out = get(args, 3, "./gen");
  // 默认字段模板（可后续扩展 --fields）
  let fs = [
    { "name": "id", "type": "integer", "required": 1, "primary": 1, "auto": 1, "system": 1, "showInList": 1, "comment": "ID" },
    { "name": "name", "type": "varchar", "required": 1, "primary": 0, "auto": 0, "system": 0, "showInList": 1, "showInForm": 1, "searchable": 1, "comment": "名称" },
    { "name": "email", "type": "varchar", "required": 0, "primary": 0, "auto": 0, "system": 0, "showInList": 1, "showInForm": 1, "searchable": 1, "comment": "邮箱" },
    { "name": "create_date", "type": "timestamp", "required": 0, "primary": 0, "auto": 0, "system": 1, "showInList": 1, "showInForm": 0, "searchable": 0, "comment": "创建时间" }
  ];
  gen_one(ctrl, fs, len(fs), db, out);
  base.base_project(out, [{ "name": ctrl, "fields": fs }]);
  print("runnable project scaffolded at " + out + " (see README.run.md)");
  return 0;
}

// 交互式创建：stdin 逐行输入字段（name type [required] [searchable]），空行结束
func cmd_init(args): int {
  let ctrl = get(args, 1, "");
  if (ctrl == "") {
    print("usage: lume-core main.lume init <module> [db] [out]");
    return 1;
  }
  let db = get(args, 2, "crm_demo");
  let out = get(args, 3, "./gen");
  let fs = [];
  push(fs, { "name": "id", "type": "integer", "required": 1, "primary": 1, "auto": 1, "system": 1, "showInList": 1, "showInForm": 0, "searchable": 0, "comment": "ID" });
  print("enter fields: name type [required] [searchable] (empty line to finish)");
  let done = 0;
  while (done == 0) {
    print("field> ");
    let line = read_stdin();
    if (line == "") { done = 1; } else {
      let parts = split(line, " ");
      let nm = trim(get(parts, 0, ""));
      if (nm == "") { done = 1; } else {
        let ty = trim(get(parts, 1, "varchar"));
        let required = 0;
        let searchable = 0;
        if (contains(line, "required")) { required = 1; }
        if (contains(line, "searchable")) { searchable = 1; }
        push(fs, { "name": nm, "type": ty, "required": required, "primary": 0, "auto": 0, "system": 0, "showInList": 1, "showInForm": 1, "searchable": searchable, "comment": nm });
        print("  + " + nm + " (" + ty + ")");
      }
    }
  }
  gen_one(ctrl, fs, len(fs), db, out);
  base.base_project(out, [{ "name": ctrl, "fields": fs }]);
  print("init done: " + ctrl + " (" + str(len(fs)) + " fields)");
  return 0;
}

// 配置文件批量生成：json 数组 modules + db + out
func cmd_config(path: string): int {
  let txt = read_file(path);
  let cfg = json(txt);
  let db = get(cfg, "db", "crm_demo");
  let out = get(cfg, "out", "./gen");
  let mods = get(cfg, "modules", []);
  base.base_project(out, mods);
  let i = 0;
  while (i < len(mods)) {
    let mod = mods[i];
    let ctrl = get(mod, "name", "");
    if (ctrl != "") {
      let fs = get(mod, "fields", []);
      gen_one(ctrl, fs, len(fs), db, out);
    }
    i = i + 1;
  }
  print("done: " + str(len(mods)) + " modules");
  return 0;
}

let args = argv();
let cmd = get(args, 0, "");
if (cmd == "create") {
  cmd_create(args);
} else if (cmd == "init") {
  cmd_init(args);
} else if (cmd != "") {
  cmd_config(cmd);
} else {
  print("usage:");
  print("  lume-core main.lume create <module> [db] [out]");
  print("  lume-core main.lume init <module> [db] [out]");
  print("  lume-core main.lume <config.json>");
}
