# ============================================================================
# lume-nsgm 环境变量模板
#   用法：cp .env.example .env  然后按需取消注释/填写
#   .env 已被 .gitignore 忽略，不会进入版本库；切勿把真实密钥提交到仓库。
# ============================================================================

# ---- 开发/构建 ----
# lume-core 可执行文件绝对路径。Makefile 用 -include .env 读取；
# 优先用它的绝对路径，没有则回退 PATH 上的 lume-core。
# 示例（按实际路径修改；README「让 lume-nsgm 找到运行时」有完整说明）：
# LUME_CORE_BIN=/Users/you/.local/bin/lume-core                  # macOS / Linux
# LUME_CORE_BIN=E:/Workspace/lume-core/bin/lume-core.exe         # Windows

# ---- 生成工程的运行配置（可选，运行时由 gen/app.lume 读取，均有默认值）----
# PORT=8081
# HOST=127.0.0.1
# WORKERS=4
# NSGM_DB=data/app.db

# ---- 支付密钥与接线（值经 compose environment 注入容器，不进镜像层）----
# ⚠️ 密钥 env 名避开 SECRET/TOKEN/PASSWORD/PASSWD/API_KEY/CREDENTIAL 等词根——
#    lume-core 的 env() 会掩码这类名字（src/builtins_fs.c env_is_sensitive），
#    读了也是 null。因此统一用 *_KEY 结尾的命名（PAYPAL_KEY）。
#
# ---- PayPal 变体（docker compose build --build-arg NSGM_CONFIG=example-paypal.json）----
# sandbox client_secret（必填；developer.paypal.com → Sandbox → App 里获取）
# PAYPAL_KEY=
# sandbox client_id（公开标识非密钥，可入库；也可写进 example-paypal.json 的
# pay.client_id，env 优先）
# PAYPAL_CLIENT_ID=
# 网关基址：sandbox https://api-m.sandbox.paypal.com ；live 去掉 .sandbox
# PAY_GATEWAY=https://api-m.sandbox.paypal.com
# approve 后跳回本服务的基址（生成工程自动拼 /api/pay/return；本地 :18081 容器见下）
# PAYPAL_RETURN_URL=http://127.0.0.1:18081
#
# ---- docker compose 宿主端口覆盖（可选，默认 18081）----
# DOCKER_PORT=18081
