// tests/t4.lume — sql_default() 回归测试（SQLite 方言）
//
// 锁定 model.sql_default() / sql_type() 经 sql.field_ctx 接进生成器后的行为：
//   1) create_date (timestamp, system) -> TEXT DEFAULT CURRENT_TIMESTAMP
//   2) update_date (timestamp, system) -> 同上（SQLite 无 ON UPDATE，
//      更新时间戳由生成的 UPDATE 语句显式携带）
//   3) 非必填 varchar (非 id)          -> TEXT DEFAULT ''
//   4) 互斥默认子句，禁止 DEFAULT NULL DEFAULT '' 这类双重默认非法 SQL
//   5) 主键行 INTEGER PRIMARY KEY AUTOINCREMENT，且无冗余 NOT NULL
//   6) 无 MySQL 方言残留（COMMENT/ENGINE/AUTO_INCREMENT/反引号）
// main() 返回失败计数 = 进程退出码，make test 据此捕获回归。

import "../lib/sql.lume" as sql;
import "../lib/assert.lume" as a;

func main() {
  // 复刻 nsgm 用户模块字段集
  let fs = [
    { "name": "id", "type": "integer", "required": 1, "primary": 1, "auto": 1, "comment": "" },
    { "name": "name", "type": "varchar", "required": 1, "comment": "姓名" },
    { "name": "email", "type": "varchar", "comment": "邮箱" },
    { "name": "create_date", "type": "timestamp", "system": 1, "comment": "" },
    { "name": "update_date", "type": "timestamp", "system": 1, "comment": "" }
  ];
  let out = sql.gen_sql("user", fs, len(fs), "crm_demo");

  let f = 0;
  f = f + a.assert_contains(out, "\"create_date\" TEXT DEFAULT CURRENT_TIMESTAMP", "create_date 自动时间戳默认");
  f = f + a.assert_contains(out, "\"update_date\" TEXT DEFAULT CURRENT_TIMESTAMP", "update_date 时间戳默认");
  f = f + a.assert_contains(out, "\"email\" TEXT DEFAULT ''", "非必填 varchar 默认空串");
  f = f + a.assert_contains(out, "\"id\" INTEGER PRIMARY KEY AUTOINCREMENT", "主键自增行");
  f = f + a.assert_not_contains(out, "DEFAULT NULL DEFAULT", "无双重 DEFAULT 子句");
  f = f + a.assert_not_contains(out, "DEFAULT '' DEFAULT", "无重复空串默认");
  f = f + a.assert_not_contains(out, "AUTOINCREMENT NOT NULL", "主键行无冗余 NOT NULL");
  f = f + a.assert_not_contains(out, "COMMENT", "无 MySQL COMMENT 子句");
  f = f + a.assert_not_contains(out, "ENGINE=", "无 MySQL ENGINE 子句");
  f = f + a.assert_not_contains(out, "AUTO_INCREMENT", "无 MySQL AUTO_INCREMENT");
  f = f + a.assert_not_contains(out, "`", "无反引号（SQLite 用双引号标识符）");

  if (f == 0) {
    print("ALL PASS (sql_default regression: " + str(len(fs)) + " fields checked)");
  } else {
    print(str(f) + " ASSERTION(S) FAILED");
  }
  return f;
}
main();
