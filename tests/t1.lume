import "../lib/sql.lume" as sql;
import "../lib/schema.lume" as schema;
let f1 = { name: "id", type: "integer", primary: true, auto: true, system: true };
let f2 = { name: "name", type: "varchar", length: 255, required: true, comment: "姓名", showInList: true, showInForm: true, searchable: true };
let f3 = { name: "email", type: "varchar", comment: "邮箱", showInList: true, showInForm: true };
let f4 = { name: "create_date", type: "timestamp", system: true };
let fs = [f1, f2, f3, f4];
print(sql.gen_sql("user", fs, 4, "crm_demo"));
print("-----");
print(schema.gen_schema("user", fs, 4));