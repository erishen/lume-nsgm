// tests/t7.lume — 支付接线回归测试（P3-8 起，微信支付支持已于 2026-10-17 移除）
//
// 覆盖三块：
//   A) scaffold/lib/pay.lume 单元向量：paypal_base_url / paypal_basic_auth /
//      paypal_fmt_cents / paypal_verify_webhook（已知答案向量，与 Python 侧独立实现互证）
//   B) validate_pay：paypal 段必填键、mode/client_id/secret_env 形状、order_module 与
//      字段必须真实存在、webhook_path 形状、provider 遗留键必须为 paypal；
//      pay 缺失时零错误；
//      validate_shop：店面键（含 P1-2 商品快照/库存三键）存在性与依赖校验
//   （字段级 default 的校验回归见 tests/t6.lume）
// main() 返回失败计数 = 进程退出码，make test 据此捕获回归。

import "../scaffold/lib/pay.lume" as pay;
import "../lib/validate.lume" as v;
import "../lib/assert.lume" as a;

// 错误串数组里任一条包含 frag（绕过 stringify 对引号的转义）
func any_contains(list, frag): int {
  let i = 0;
  while (i < len(list)) {
    if (contains(list[i], frag)) { return 1; }
    i = i + 1;
  }
  return 0;
}

// ---------- A) pay.lume 单元向量（PayPal）----------

func main() {
  let f = 0;

  // ---------- A2) PayPal 单元向量（OAuth2 Basic / 金额格式化 / webhook 验签）----------
  f = f + a.assert_true(pay.paypal_base_url("sandbox") == "https://api-m.sandbox.paypal.com",
    "t7: paypal_base_url sandbox");
  f = f + a.assert_true(pay.paypal_base_url("live") == "https://api-m.paypal.com",
    "t7: paypal_base_url live");

  // paypal_basic_auth：Basic base64(client_id:client_secret)（与 RFC7617 一致）
  f = f + a.assert_true(pay.paypal_basic_auth("id", "secret") == "Basic aWQ6c2VjcmV0",
    "t7: paypal_basic_auth known-answer (id:secret -> Base64 aWQ6c2VjcmV0)");
  f = f + a.assert_true(pay.paypal_basic_auth("id", "secret") == "Basic " + base64_encode("id:secret"),
    "t7: paypal_basic_auth equals Basic+base64(client_id:secret)");

  // paypal_fmt_cents：整数分 -> "x.xx"（无浮点）
  f = f + a.assert_true(pay.paypal_fmt_cents(12345) == "123.45", "t7: paypal_fmt_cents 12345");
  f = f + a.assert_true(pay.paypal_fmt_cents(100) == "1.00", "t7: paypal_fmt_cents 100");
  f = f + a.assert_true(pay.paypal_fmt_cents(5) == "0.05", "t7: paypal_fmt_cents 5");
  f = f + a.assert_true(pay.paypal_fmt_cents(0) == "0.00", "t7: paypal_fmt_cents 0");

  // paypal_verify_webhook：HMAC(id\n+ts\n+body\n) 往返 + 拒错/拒空
  let wsig = hmac_sha256("s3c", "id1\n1700000002\nbody\n");
  f = f + a.assert_true(pay.paypal_verify_webhook("s3c", "id1", "1700000002", "body", wsig) == true,
    "t7: paypal_verify_webhook roundtrip ok");
  f = f + a.assert_true(pay.paypal_verify_webhook("s3c", "id1", "1700000002", "body", "deadbeef") == false,
    "t7: paypal_verify_webhook must reject wrong signature");
  f = f + a.assert_true(pay.paypal_verify_webhook("s3c", "id1", "1700000002", "body", "") == false,
    "t7: paypal_verify_webhook must reject empty signature");

  // ---------- B) validate_pay ----------

  let mods = [
    { "name": "order", "fields": [
      { "name": "id", "type": "integer", "primary": 1, "auto": 1, "system": 1 },
      { "name": "order_no", "type": "varchar", "required": 1 },
      { "name": "amount_cents", "type": "integer", "required": 1 },
      { "name": "product_id", "type": "integer" },
      { "name": "product_name", "type": "varchar" },
      { "name": "status", "type": "varchar" }
    ] },
    { "name": "product", "fields": [
      { "name": "id", "type": "integer", "primary": 1, "auto": 1, "system": 1 },
      { "name": "name", "type": "varchar", "required": 1 },
      { "name": "price_cents", "type": "integer", "required": 1 },
      { "name": "stock", "type": "integer" }
    ] }
  ];
  // ---------- B2) validate_pay paypal 分支 ----------
  let good_paypal = {
    "provider": "paypal",
    "client_id": "AUmock_client_id_sandbox_001",
    "secret_env": "PAYPAL_KEY",
    "mode": "sandbox",
    "order_module": "order",
    "order_no_field": "order_no",
    "amount_field": "amount_cents",
    "status_field": "status",
    "webhook_path": "/api/pay/webhook"
  };
  f = f + a.assert_true(len(v.validate_pay(good_paypal, mods)) == 0,
    "t7: valid paypal section must pass");

  // provider 遗留键：微信支付支持已移除，配置里写 wechat 必须收到明确报错
  // （而非静默走错分支——旧配置升级时的第一道防线）
  let wx_legacy = {
    "provider": "wechat", "client_id": "AU1", "secret_env": "PAYPAL_KEY",
    "mode": "sandbox", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_true(any_contains(v.validate_pay(wx_legacy, mods),
      "provider: must be \"paypal\""),
    "t7: provider=wechat must be rejected (support removed)");
  // provider=paypal 显式书写仍然放行（向后兼容旧配置）
  f = f + a.assert_true(len(v.validate_pay(good_paypal, mods)) == 0,
    "t7: provider=paypal must still pass (legacy key tolerated)");

  // 缺必填键（client_id）
  let no_cid = {
    "provider": "paypal", "secret_env": "PAYPAL_KEY", "mode": "sandbox",
    "order_module": "order", "order_no_field": "order_no",
    "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_true(any_contains(v.validate_pay(no_cid, mods), "missing required \"client_id\""),
    "t7: paypal missing client_id must be reported");

  // mode 非法
  let bad_mode = {
    "provider": "paypal", "client_id": "AU1", "secret_env": "PAYPAL_KEY",
    "mode": "staging", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_mode, mods)), ".mode: must be",
    "t7: paypal mode must be sandbox|live");

  // client_id 字符集
  let bad_cid = {
    "provider": "paypal", "client_id": "AU 1", "secret_env": "PAYPAL_KEY",
    "mode": "sandbox", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_cid, mods)), ".client_id: must match [A-Za-z0-9_-]",
    "t7: paypal client_id charset must be enforced");

  // secret_env 名形状
  let bad_penv = {
    "provider": "paypal", "client_id": "AU1", "secret_env": "paypal-secret",
    "mode": "sandbox", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_penv, mods)), ".secret_env: must match [A-Z][A-Z0-9_]*",
    "t7: paypal secret_env name shape must be enforced");

  // order_module/字段存在性（与 paypal 主路径同口径）
  let bad_pmod = {
    "provider": "paypal", "client_id": "AU1", "secret_env": "PAYPAL_KEY",
    "mode": "sandbox", "order_module": "orders",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_pmod, mods)), "is not a defined module",
    "t7: paypal unknown order_module must be reported");
  let bad_pfield = {
    "provider": "paypal", "client_id": "AU1", "secret_env": "PAYPAL_KEY",
    "mode": "sandbox", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount", "status_field": "status"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_pfield, mods)), "is not a field of module",
    "t7: paypal unknown amount_field must be reported");

  // webhook_path 形状
  let bad_pwh = {
    "provider": "paypal", "client_id": "AU1", "secret_env": "PAYPAL_KEY",
    "mode": "sandbox", "order_module": "order",
    "order_no_field": "order_no", "amount_field": "amount_cents", "status_field": "status",
    "webhook_path": "api/pay/webhook"
  };
  f = f + a.assert_contains(stringify(v.validate_pay(bad_pwh, mods)), ".webhook_path: must be a path",
    "t7: paypal webhook_path must start with /");

  // ---------- B3) validate_shop ----------
  let good_shop = { "product_module": "product", "order_module": "order", "name_field": "name", "price_field": "price_cents" };
  f = f + a.assert_true(len(v.validate_shop(good_shop, null, mods)) == 0,
    "t7: valid shop section must pass");
  f = f + a.assert_true(len(v.validate_shop(null, null, mods)) == 0,
    "t7: null shop must pass (optional section)");
  let no_pm = { "order_module": "order" };
  f = f + a.assert_true(any_contains(v.validate_shop(no_pm, null, mods), "missing required \"product_module\""),
    "t7: shop without product_module must be reported");
  let bad_pm = { "product_module": "products", "order_module": "order" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_pm, null, mods), "is not a defined module"),
    "t7: shop unknown product_module must be reported");
  let bad_pf = { "product_module": "product", "order_module": "order", "price_field": "price" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_pf, null, mods), "price_field: \"price\" is not a field"),
    "t7: shop unknown price_field must be reported");

  // ---------- B4) validate_shop 商品快照/库存键（P1-2）----------
  // 三键齐配（pay 提供订单模块）放行；各键不存在/缺依赖/形状错都要报
  let good_stock = {
    "product_module": "product", "order_module": "order",
    "name_field": "name", "price_field": "price_cents",
    "stock_field": "stock", "product_field": "product_id", "product_name_field": "product_name"
  };
  f = f + a.assert_true(len(v.validate_shop(good_stock, good_paypal, mods)) == 0,
    "t7: shop with stock/product snapshot keys must pass");
  let bad_skf = { "product_module": "product", "order_module": "order",
                  "stock_field": "stockx", "product_field": "product_id" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_skf, good_paypal, mods),
      "stock_field: \"stockx\" is not a field"),
    "t7: shop unknown stock_field must be reported");
  let skf_no_prdf = { "product_module": "product", "order_module": "order", "stock_field": "stock" };
  f = f + a.assert_true(any_contains(v.validate_shop(skf_no_prdf, good_paypal, mods),
      "stock_field: requires \"product_field\""),
    "t7: shop stock_field without product_field must be reported");
  let bad_prdf = { "product_module": "product", "order_module": "order", "product_field": "pid_x" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_prdf, good_paypal, mods),
      "product_field: \"pid_x\" is not a field of module \"order\""),
    "t7: shop unknown product_field must be reported");
  let bad_pnmf = { "product_module": "product", "order_module": "order", "product_name_field": "pname_x" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_pnmf, good_paypal, mods),
      "product_name_field: \"pname_x\" is not a field"),
    "t7: shop unknown product_name_field must be reported");
  let bad_prdf_id = { "product_module": "product", "order_module": "order", "product_field": "Product-Id" };
  f = f + a.assert_true(any_contains(v.validate_shop(bad_prdf_id, good_paypal, mods),
      "product_field: \"Product-Id\" must match"),
    "t7: shop product_field ident shape must be enforced");
  // pay 缺失时店面不生成，新键惰性无副作用
  f = f + a.assert_true(len(v.validate_shop(good_stock, null, mods)) == 0,
    "t7: shop snapshot keys inert without pay");

  print("t7: " + str(f) + " failure(s)");
  return f;
}

main();
