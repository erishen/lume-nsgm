// tests/t5.lume — React 前端生成器（reactgen）回归断言
// 锁：页面组件结构（受控表单/hooks/API 调用/时间格式化）、App.tsx 路由装配、
// 无未渲染 mustache 残留。main() 返回失败数即退出码。
import "../lib/reactgen.lume" as rg;
import "../lib/assert.lume" as a;

let fs = [
  { "name": "id", "type": "integer", "required": 1, "primary": 1, "auto": 1, "system": 1, "showInList": 1, "comment": "ID" },
  { "name": "name", "type": "varchar", "required": 1, "showInList": 1, "showInForm": 1, "searchable": 1, "comment": "姓名" },
  { "name": "email", "type": "varchar", "showInList": 1, "showInForm": 1, "comment": "邮箱" },
  { "name": "amount", "type": "decimal", "showInList": 1, "showInForm": 1, "comment": "金额" },
  { "name": "create_date", "type": "timestamp", "system": 1, "showInList": 1, "comment": "创建时间" }
];

let page = rg.gen_page_tsx("user", fs, len(fs), "", "", "");
// 店面订单模块页：paid 行注入退款链接（rono/rst/csym 来自 pay 配置字段）
let order_page = rg.gen_page_tsx("order", fs, len(fs), "order_no", "status", "$");
let app = rg.gen_app_tsx([{ "name": "user", "label": "用户" }, { "name": "order", "label": "订单" }], 0);
let app_shop = rg.gen_app_tsx([{ "name": "user", "label": "用户" }], 1);

let fails = 0;

// 页面组件结构：组件名、hooks、API 客户端调用
fails = fails + a.assert_contains(page, "export default function UserPage", "t5: component named UserPage");
fails = fails + a.assert_contains(page, "const [rows, setRows] = useState<Row[]>([])", "t5: rows state via useState");
fails = fails + a.assert_contains(page, "useEffect(", "t5: data loading via useEffect");
fails = fails + a.assert_contains(page, "apiList(CTRL", "t5: list via apiList(CTRL)");
fails = fails + a.assert_contains(page, "apiAdd(CTRL, data)", "t5: create via apiAdd");
fails = fails + a.assert_contains(page, "apiUpdate(CTRL, Number(editing.id), data)", "t5: update via apiUpdate");
fails = fails + a.assert_contains(page, "apiDelete(CTRL, id)", "t5: delete via apiDelete");
fails = fails + a.assert_contains(page, "window.confirm(\"确认删除该记录？此操作不可恢复。\")", "t5: delete confirm dialog");
fails = fails + a.assert_contains(page, "fmtTime(row[f.name])", "t5: timestamp cells via fmtTime");

// 数据驱动字段：number 输入映射 decimal、时间列标记 is_ts、searchable 暴露
fails = fails + a.assert_contains(page, "{ name: \"amount\", label: \"金额\", form: 1, search: 0, required: 0, list: 1, input_type: \"number\", is_ts: 0, is_ref: 0, target: \"\", is_enum: 0, values_json: [] }", "t5: decimal field maps to number input");
fails = fails + a.assert_contains(page, "{ name: \"create_date\", label: \"创建时间\", form: 0, search: 0, required: 0, list: 1, input_type: \"text\", is_ts: 1, is_ref: 0, target: \"\", is_enum: 0, values_json: [] }", "t5: system timestamp excluded from form, marked is_ts");
fails = fails + a.assert_contains(page, "const HAS_SEARCH = FIELDS.some((f) => f.search === 1);", "t5: search box conditional on searchable fields");

// 不得有未渲染 mustache / 模板残留
fails = fails + a.assert_not_contains(page, "{{", "t5: no unrendered mustache in page");
fails = fails + a.assert_not_contains(page, "useState<any>", "t5: no untyped any state");

// 店面订单模块页：操作列 paid 行退款链接；普通模块页不注入
fails = fails + a.assert_contains(order_page, "shop/refund/\" + encodeURIComponent(String(row[\"order_no\"]", "t5: order page refund link targets #/shop/refund/:ono");
fails = fails + a.assert_contains(order_page, "=== \"paid\"", "t5: refund link gated on paid rows");
fails = fails + a.assert_contains(order_page, "=== \"refunded\" ? null : (", "t5: refunded rows locked out of edit/delete");
fails = fails + a.assert_not_contains(order_page, "{{", "t5: no unrendered mustache in order page");
fails = fails + a.assert_not_contains(page, "shop/refund", "t5: non-order page has no refund link");
fails = fails + a.assert_not_contains(page, "row[\"status\"]", "t5: non-order page has no refund-status gating");

// 服务端守卫拒绝（{ok:false,err,msg}）要在 UI 面呈现，不能假报「已保存」
fails = fails + a.assert_contains(page, "res.ok === false", "t5: save/delete surface ok:false guard rejections");

// 金额/状态列渲染（与 SSR 对齐）：订单页 *_cents 列出等宽金额、status 列出徽标
fails = fails + a.assert_contains(order_page, "const CSYM = \"$\"", "t5: order page currency symbol injected");
fails = fails + a.assert_contains(order_page, "f.name.endsWith(\"_cents\") ? \"money\" : \"\"", "t5: cents columns get money class");
fails = fails + a.assert_contains(order_page, "f.name === \"status\"", "t5: status column renders badge");
fails = fails + a.assert_contains(order_page, "st st-ok", "t5: paid status badge (green)");
fails = fails + a.assert_contains(order_page, "st st-warn", "t5: pending status badge (amber)");
fails = fails + a.assert_not_contains(page, "const CSYM = \"$\"", "t5: non-order page has no currency formatting");

// 加载态 + 客户端排序（对齐 SSR 表头排序能力）
fails = fails + a.assert_contains(page, "const [loaded, setLoaded] = useState(false)", "t5: loaded state avoids empty-state flash");
fails = fails + a.assert_contains(page, "<div className=\"ico\">⏳</div>", "t5: loading row while !loaded");
fails = fails + a.assert_contains(page, "className=\"sortable\"", "t5: sortable column headers");
fails = fails + a.assert_contains(page, "function toggleSort(", "t5: header click toggles sort");
fails = fails + a.assert_contains(page, "viewRows = sort ? [...rows].sort(", "t5: client-side sort applied to view rows");

// App.tsx：路由装配 + NAV 注入
fails = fails + a.assert_contains(app, "import UserPage from \"./pages/UserPage\"", "t5: App imports UserPage");
fails = fails + a.assert_contains(app, "import OrderPage from \"./pages/OrderPage\"", "t5: App imports OrderPage");
fails = fails + a.assert_contains(app, "{ name: \"user\", label: \"用户\", comp: UserPage }", "t5: TABS entry with label");
fails = fails + a.assert_contains(app, "window.addEventListener(\"hashchange\", onHash)", "t5: hash routing wired");
fails = fails + a.assert_contains(app, "<active.comp />", "t5: active tab rendered");
fails = fails + a.assert_contains(app, "document.title", "t5: document title synced to route");

// hasShop=0：不得注入店面/支付路由（ShopPage 等未被 import，纯 CRUD 变体可编译）
fails = fails + a.assert_not_contains(app, "SHOP_ROUTES", "t5: no shop routes without shop config");
fails = fails + a.assert_not_contains(app, "ShopPage", "t5: no ShopPage import without shop config");
fails = fails + a.assert_not_contains(app, "PayReturnPage", "t5: no PayReturnPage without shop config");

// hasShop=1：店面/支付 hash 路由注入（#:shop 列表 + 参数路由 + PayPal 回跳）
fails = fails + a.assert_contains(app_shop, "import ShopPage from \"./pages/ShopPage\"", "t5: shop App imports ShopPage");
fails = fails + a.assert_contains(app_shop, "const SHOP_ROUTES", "t5: shop routes table emitted");
fails = fails + a.assert_contains(app_shop, "{ prefix: \"shop/pay/\", comp: CashierPage }", "t5: cashier param route");
fails = fails + a.assert_contains(app_shop, "{ prefix: \"shop/refund/\", comp: RefundPage }", "t5: refund param route");
fails = fails + a.assert_contains(app_shop, "cur === \"pay/return\" || cur === \"pay/cancel\"", "t5: PayPal hash return/cancel routes");
fails = fails + a.assert_contains(app_shop, "body = <PayReturnPage mode=", "t5: PayPal return page rendered");
fails = fails + a.assert_contains(app_shop, "href=\"#/shop\"", "t5: shop nav link emitted");

func main(): int {
  if (fails == 0) { print("ALL PASS (t5: reactgen)"); }
  else { print(str(fails) + " ASSERTION(S) FAILED"); }
  return fails;
}

main();
