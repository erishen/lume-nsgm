// db.lume — SQLite 存取辅助（lume-nsgm 生成项目的静态基座）
//
// sql_query/sql_write 由 lume-core（0.6.0+）内建提供：? 占位符参数绑定
// （值永不进 SQL 字符串）。SQLite 文件路径即 DSN；仅支持 SQLite
// （postgres/mysql 不在 core 内建范围内）。

// 库文件路径：env NSGM_DB 可覆盖，默认 data/app.db（相对生成项目根）
let DSN = "data/app.db";
let from_env = env("NSGM_DB");
if (from_env != null && from_env != "") { DSN = from_env; }

export func dsn(): string { return DSN; }

// 启动建表：CREATE TABLE IF NOT EXISTS 幂等（sql_write 放行 CREATE TABLE）
export func init(ddls): int {
  // db_layer 以 SQLITE_OPEN_READWRITE 打开（不带 CREATE）——库文件必须已存在；
  // 0 字节文件对 SQLite 就是空库，首次启动垫上
  if (read_file(DSN) == null) { write_file(DSN, ""); }
  let i = 0;
  while (i < len(ddls)) {
    let stmt = get(ddls, i, "");
    if (stmt != "") {
      sql_write(DSN, stmt, []);
    }
    i = i + 1;
  }
  return 0;
}

// SELECT COUNT(*) AS counts 查询结果取总数
export func count_of(rows): int {
  if (len(rows) == 0) { return 0; }
  return get(rows[0], "counts", 0);
}

// req.query_params 可能为 null（无 query string），统一成空 map
export func qparams(req) {
  if (req.query_params == null) { return {}; }
  return req.query_params;
}

// 取整型 query 参数（缺失/非法回落默认值）
export func qs_int(qp, k: string, dflt: int): int {
  let raw = get(qp, k, "");
  if (raw == "") { return dflt; }
  return int(raw);
}

// list 拼接（dst += src），返回 dst
export func push_all(dst, src) {
  let i = 0;
  while (i < len(src)) {
    push(dst, src[i]);
    i = i + 1;
  }
  return dst;
}
