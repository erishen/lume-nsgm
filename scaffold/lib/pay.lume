// pay.lume — 支付库（lume-nsgm 生成项目的静态基座，随 scaffold 复制到 gen/lib/）
//
// 支付适配器：PayPal Express Checkout（provider: paypal）。
//   OAuth2 Bearer + REST Orders v2（建单 / 捕获 / 查单兜底 / 退款 / webhook 验签）。
//   OAuth2 的 HTTP Basic 凭证 base64(client_id:client_secret) 用到 lume-core
//   0.7.0+ 的 base64_encode 内建。
//
// 已知边界（沙箱等价实现，详见 README「支付」节与 TODO S7）：
//   - webhook 验签为纯 HMAC 简化版：真实 PayPal webhook 签名含 crc32(body)，
//     core 暂无 crc32 内建 ⇒ 验签材料（verify_id / verify_ts / verify_sign）
//     随 JSON body 传递（沙箱约定）；
//   - 返回/回调走 query_params（core 的 req.query_params 已解析），不依赖请求头；
//   - 无随机源 ⇒ 业务单号由生成器侧派生（order_no + now()），沙箱够用。

// 整数分 -> "x.xx"（不用浮点，规避 .2f 精度风险）
export func paypal_fmt_cents(cents: int): string {
  let d = int(cents / 100);
  let r = cents - d * 100;
  let rs = str(r);
  if (r < 10) { rs = "0" + rs; }
  return str(d) + "." + rs;
}

// 金额展示（分 -> "x.xx" 元）：整数运算无浮点误差，店面/后台通用。
export func fmt_cents(cents: int): string {
  return paypal_fmt_cents(cents);
}

// ============================================================================
// PayPal Express Checkout
//
// 流程：OAuth2 client_credentials 拿 Bearer token → POST /v2/checkout/orders
// 建单拿 approve_url（浏览器跳转）→ 用户在 PayPal approve → PayPal 跳回
// return_url?token=<paypal_order_id> → 服务端 POST .../capture 捕获 → 改本单
// 状态。webhook 为异步事件，沙箱内用简化 HMAC 验签（见文件头 S7/PayPal 说明）。
//
// 金额用整数 cents，转 "x.xx" 字符串（fmt_cents）。
// OK 一律用 bool（lume 运行时 bool==int 恒 false，必须用 != true 比较）。
// ============================================================================

// 沙箱 / 生产 base URL（与 oscar facade 同口径）
export func paypal_base_url(mode: string): string {
  if (mode == "live") { return "https://api-m.paypal.com"; }
  return "https://api-m.sandbox.paypal.com";
}

// OAuth2 HTTP Basic 凭证值：Basic base64(client_id:client_secret)
export func paypal_basic_auth(client_id: string, secret: string): string {
  return "Basic " + base64_encode(client_id + ":" + secret);
}

// 令牌简单缓存：PayPal token 有效期约 9h，进程内复用避免每次建单都握手。
// 模块级状态随生成后的单进程生命周期持续；过期阈值取保守的 30000s。
let PAYPAL_TOK_CACHE = { "token": "", "exp": 0 };

// 出站 POST 带传输层重试：国内链路到 PayPal 沙箱偶发 TLS EOF / 响应超时
// （当日实测一次即自愈，但收银台/捕获是用户可见路径，不能把恢复成本转嫁给
// 用户手动重试）。http_post 的 ok=false 只表示传输失败（connect/TLS/超时），
// HTTP 4xx/5xx 仍 ok=true——按 ok 重试不会重放已被服务端拒绝的请求。
// core 无 sleep 内建，立即重试（单次超时本身即等待，见 opts.timeout）。
func pp_post(url: string, opts) {
  let r = http_post(url, opts);
  let n = 0;
  while (get(r, "ok", false) != true && n < 2) {
    r = http_post(url, opts);
    n = n + 1;
  }
  return r;
}

// 取 access_token：命中未过期缓存直接返回，否则 OAuth2 握手。
// cfg = { gw, client_id, client_secret }；返回 { ok, token, err }
export func paypal_token(cfg) {
  if (PAYPAL_TOK_CACHE.token != "" && now() < PAYPAL_TOK_CACHE.exp) {
    return { "ok": true, "token": PAYPAL_TOK_CACHE.token, "err": "" };
  }
  let url = str(get(cfg, "gw", "")) + "/v1/oauth2/token";
  let r = pp_post(url, {
    "headers": {
      "Authorization": paypal_basic_auth(str(get(cfg, "client_id", "")),
                                          str(get(cfg, "client_secret", ""))),
      "Accept": "application/json",
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "grant_type=client_credentials",
    "allow_private": true,
    "timeout": 30
  });
  if (get(r, "ok", false) != true) {
    return { "ok": false, "token": "", "err": str(get(r, "err", "paypal token http fail")) };
  }
  let status = int(get(r, "status", 0));
  if (status < 200 || status >= 300) {
    return { "ok": false, "token": "", "err": "paypal token status " + str(status) };
  }
  // try() 返回 {ok:值, err:null} 包装（失败时 ok=null），必须先解包——
  // 直接拿 try 的返回值当 JSON 用会永远读不到 access_token（曾在此栽过）。
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "token": "", "err": "invalid json from paypal token" };
  }
  let tok = get(j, "access_token", "");
  if (tok == "") {
    return { "ok": false, "token": "", "err": "paypal token missing in response" };
  }
  PAYPAL_TOK_CACHE.token = tok;
  // now() 是秒；PayPal token 寿命 3600s，留 600s 余量（原 30000 已超寿命，
  // 会在 1h 后继续用过期的 token 打 401）。
  PAYPAL_TOK_CACHE.exp = now() + 3000;
  return { "ok": true, "token": tok, "err": "" };
}

// 建单：POST {gw}/v2/checkout/orders，intent=CAPTURE。
// 返回 { ok, approve_url, paypal_order_id, err }
export func paypal_create(cfg, token: string, order_no: string, cents: int, desc: string,
                          return_url: string, cancel_url: string) {
  let url = str(get(cfg, "gw", "")) + "/v2/checkout/orders";
  let body = stringify({
    "intent": "CAPTURE",
    "purchase_units": [{
      "amount": {
        "currency_code": str(get(cfg, "currency", "USD")),
        "value": paypal_fmt_cents(cents)
      }
    }],
    "application_context": {
      "return_url": return_url,
      "cancel_url": cancel_url,
      "brand_name": str(get(cfg, "brand", "lume-nsgm")),
      "landing_page": "LOGIN",
      "user_action": "PAY_NOW",
      "shipping_preference": "NO_SHIPPING"
    }
  });
  let r = pp_post(url, {
    "headers": {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json",
      "Prefer": "return=representation"
    },
    "body": body,
    "allow_private": true,
    "timeout": 30
  });
  let status = int(get(r, "status", 0));
  if (get(r, "ok", false) != true || status < 200 || status >= 300) {
    let rbody = str(get(r, "body", ""));
    return { "ok": false, "approve_url": "", "paypal_order_id": "",
             "err": str(get(r, "err", "")) + (rbody != "" ? " body=" + rbody : "") };
  }
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "approve_url": "", "paypal_order_id": "",
             "err": "invalid json from paypal create" };
  }
  let oid = str(get(j, "id", ""));
  let approve = "";
  let links = get(j, "links", []);
  let i = 0;
  while (i < len(links)) {
    let lk = links[i];
    if (get(lk, "rel", "") == "approve") { approve = str(get(lk, "href", "")); }
    i = i + 1;
  }
  if (oid == "" || approve == "") {
    return { "ok": false, "approve_url": "", "paypal_order_id": "",
             "err": "paypal create: missing id/approve link" };
  }
  return { "ok": true, "approve_url": approve, "paypal_order_id": oid, "err": "" };
}

// 由 PayPal 订单 ID 重建 approve 链接（收银台复用已建单时用，避免重复建单）：
//   - 本地/mock 网关（gw 指向 127.0.0.1/localhost）：mock 收银台
//     {gw}/mock/paypal/approve?token=<id>（与 mock_pay_gateway.py 建单时下发的
//     approve 链接同形，token 即订单 ID）；
//   - 真实 PayPal（v2 Orders）：https://{www|www.sandbox}.paypal.com/checkoutnow?token=<id>。
// 本地单仍 pending 才复用（收银台对 paid 单直接跳结果页），PayPal 侧订单在
// 用户 approve 前一直可支付；已 approve/捕获的单本地已 paid，走不到复用分支。
export func paypal_approve_url(cfg, paypal_order_id: string): string {
  let gw = str(get(cfg, "gw", ""));
  if (contains(gw, "127.0.0.1") || contains(gw, "localhost")) {
    return gw + "/mock/paypal/approve?token=" + paypal_order_id;
  }
  let base = "https://www.paypal.com";
  if (contains(gw, "sandbox")) { base = "https://www.sandbox.paypal.com"; }
  return base + "/checkoutnow?token=" + paypal_order_id;
}

// 捕获：POST {gw}/v2/checkout/orders/{id}/capture（幂等由 PayPal 侧 order 状态保证）。
// 返回 { ok, status, capture_id, err }
export func paypal_capture(cfg, token: string, paypal_order_id: string) {
  let url = str(get(cfg, "gw", "")) + "/v2/checkout/orders/" + paypal_order_id + "/capture";
  let r = pp_post(url, {
    "headers": {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json"
    },
    "body": "{}",
    "allow_private": true,
    "timeout": 30
  });
  let status = int(get(r, "status", 0));
  if (get(r, "ok", false) != true || status < 200 || status >= 300) {
    let rbody = str(get(r, "body", ""));
    // 重复捕获对账：PayPal 对已 CAPTURED 的单再 capture 回 422
    // ORDER_ALREADY_CAPTURED——典型场景是上次捕获其实已成功、只是响应超时
    // （当日实测：10s 超时后用户手动重试）。按成功处理，避免重复扣款/卡单。
    if (status == 422 && contains(rbody, "ORDER_ALREADY_CAPTURED")) {
      return { "ok": true, "status": "COMPLETED", "capture_id": "", "err": "" };
    }
    return { "ok": false, "status": "", "capture_id": "",
                 "err": str(get(r, "err", "")) + (rbody != "" ? " body=" + rbody : "") };
  }
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "status": "", "capture_id": "", "err": "invalid json from paypal capture" };
  }
  let cap = "";
  let pus = get(j, "purchase_units", []);
  if (len(pus) > 0) {
    let caps = get(pus[0], "payments", {});
    let cl = get(caps, "captures", []);
    if (len(cl) > 0) { cap = str(get(cl[0], "id", "")); }
  }
  return { "ok": true, "status": str(get(j, "status", "")), "capture_id": cap, "err": "" };
}

// webhook 简化验签：HMAC-SHA256 重算 transmission_id\n时间戳\n报文主体\n 并比对。
// 真实 PayPal webhook 还含 crc32(body)（core 暂无 crc32 内建），此处为沙箱等价实现；
// 验签材料随 JSON body 传递（verify_id / verify_ts / verify_sign / payload），沿用 S7 边界。
export func paypal_verify_webhook(secret: string, id: string, ts: string, body: string, sign_hex: string): bool {
  if (sign_hex == "") { return false; }
  let expect = hmac_sha256(secret, id + "\n" + ts + "\n" + body + "\n");
  return expect == sign_hex;
}

// ============================================================================
// 退款（生成器的 /shop/refund 路由调用）
//
// PayPal：退款对象是「捕获」而非订单——POST /v2/payments/captures/{capture_id}/refund。
//   捕获时拿到的 capture_id 由生成器回填订单表；旧订单（退款功能上线前捕获的）
//   没有回填列，用 paypal_get_order() 从 PayPal 侧反查捕获 ID 兜底。
//   用户恢复关联 ID 时常把后台的「交易号 / Transaction ID」（即捕获 ID）当订单号
//   填入——订单 GET 对捕获 ID 回 404 RESOURCE_NOT_FOUND，此时用 paypal_get_capture()
//   改查捕获接口兜底（捕获详情的 related_ids.order_id 反解订单号）。
// ============================================================================

// 出站 GET 带传输层重试（语义同 pp_post：只重试传输失败，4xx/5xx 不重放）
func pp_get(url: string, opts) {
  let r = http_get(url, opts);
  let n = 0;
  while (get(r, "ok", false) != true && n < 2) {
    r = http_get(url, opts);
    n = n + 1;
  }
  return r;
}

// 查单：GET {gw}/v2/checkout/orders/{id}，从 purchase_units[0].payments.captures[0]
// 反查捕获 ID（退款兜底：本地订单表没有 capture_id 的旧单）。
// 返回 { ok, capture_id, order_status, err }
export func paypal_get_order(cfg, token: string, paypal_order_id: string) {
  let url = str(get(cfg, "gw", "")) + "/v2/checkout/orders/" + paypal_order_id;
  let r = pp_get(url, {
    "headers": {
      "Authorization": "Bearer " + token,
      "Accept": "application/json"
    },
    "allow_private": true,
    "timeout": 30
  });
  let status = int(get(r, "status", 0));
  if (get(r, "ok", false) != true || status < 200 || status >= 300) {
    let rbody = str(get(r, "body", ""));
    return { "ok": false, "capture_id": "", "order_status": "",
             "err": str(get(r, "err", "")) + (rbody != "" ? " body=" + rbody : "") };
  }
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "capture_id": "", "order_status": "", "err": "invalid json from paypal get order" };
  }
  let cap = "";
  let pus = get(j, "purchase_units", []);
  if (len(pus) > 0) {
    let caps = get(get(pus[0], "payments", {}), "captures", []);
    if (len(caps) > 0) { cap = str(get(caps[0], "id", "")); }
  }
  return { "ok": true, "capture_id": cap, "order_status": str(get(j, "status", "")), "err": "" };
}

// 查捕获：GET {gw}/v2/payments/captures/{id}。
// 兜底路径：订单 GET 404（用户把「交易号/Transaction ID」即捕获 ID 当订单号填入，
// PayPal 回 RESOURCE_NOT_FOUND/INVALID_RESOURCE_ID）后改查本接口。捕获详情的
// supplementary_data.related_ids.order_id 反解真实订单号，使回填两列都拿到正确值。
// 返回 { ok, capture_id, order_id, order_status, err }
export func paypal_get_capture(cfg, token: string, capture_id: string) {
  let url = str(get(cfg, "gw", "")) + "/v2/payments/captures/" + capture_id;
  let r = pp_get(url, {
    "headers": {
      "Authorization": "Bearer " + token,
      "Accept": "application/json"
    },
    "allow_private": true,
    "timeout": 30
  });
  let status = int(get(r, "status", 0));
  if (get(r, "ok", false) != true || status < 200 || status >= 300) {
    let rbody = str(get(r, "body", ""));
    return { "ok": false, "capture_id": "", "order_id": "", "order_status": "",
             "err": str(get(r, "err", "")) + (rbody != "" ? " body=" + rbody : "") };
  }
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "capture_id": "", "order_id": "", "order_status": "",
             "err": "invalid json from paypal get capture" };
  }
  let sup = get(j, "supplementary_data", {});
  let rel = get(sup, "related_ids", {});
  return { "ok": true, "capture_id": capture_id,
           "order_id": str(get(rel, "order_id", "")),
           "order_status": str(get(j, "status", "")), "err": "" };
}

// 退款：POST {gw}/v2/payments/captures/{capture_id}/refund，默认全额退。
// 返回 { ok, refund_id, status, err }
// 幂等对账：重复退款 PayPal 回 422。issue 编码随金额/历史情形有几种（真实沙箱
// 2026-10-17 实证：已全额退再退回 CAPTURE_FULLY_REFUNDED；文档与旧 mock 用
// ALREADY_REFUNDED；部分退后再退同额回 REFUND_ALREADY_EXISTS/DUPLICATE）——
// 都说明上一次其实已退成功，按成功处理，避免用户看到假失败。
export func paypal_refund(cfg, token: string, capture_id: string, cents: int, note: string) {
  let url = str(get(cfg, "gw", "")) + "/v2/payments/captures/" + capture_id + "/refund";
  let body = stringify({
    "amount": {
      "value": paypal_fmt_cents(cents),
      "currency_code": str(get(cfg, "currency", "USD"))
    },
    "note_to_payer": note
  });
  let r = pp_post(url, {
    "headers": {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "body": body,
    "allow_private": true,
    "timeout": 30
  });
  let status = int(get(r, "status", 0));
  if (get(r, "ok", false) != true || status < 200 || status >= 300) {
    let rbody = str(get(r, "body", ""));
    if (status == 422 && (contains(rbody, "ALREADY_REFUNDED")
                       || contains(rbody, "CAPTURE_FULLY_REFUNDED")
                       || contains(rbody, "REFUND_ALREADY_EXISTS")
                       || contains(rbody, "DUPLICATE"))) {
      return { "ok": true, "refund_id": "", "status": "COMPLETED", "err": "" };
    }
    return { "ok": false, "refund_id": "", "status": "",
             "err": str(get(r, "err", "")) + (rbody != "" ? " body=" + rbody : "") };
  }
  let jr = try(() => json(str(get(r, "body", ""))));
  let j = get(jr, "ok", null);
  if (j == null) {
    return { "ok": false, "refund_id": "", "status": "", "err": "invalid json from paypal refund" };
  }
  return { "ok": true, "refund_id": str(get(j, "id", "")), "status": str(get(j, "status", "")), "err": "" };
}
